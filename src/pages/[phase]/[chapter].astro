---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LevelBadge from '../../components/LevelBadge.astro';
import { phases, pad, readingOrder, type Phase, type ChapterPlan } from '../../data/curriculum';
import { getReadyIds, readingMinutes } from '../../lib/book';

export function getStaticPaths() {
  return readingOrder.map(({ phase, chapter, index }) => ({
    params: { phase: phase.slug, chapter: chapter.slug },
    props: { phase, chapter, index },
  }));
}

interface Props { phase: Phase; chapter: ChapterPlan; index: number }
const { phase, chapter, index } = Astro.props;
const id = `${phase.slug}/${chapter.slug}`;
const entry = await getEntry('chapters', id);
const ready = await getReadyIds();

const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const headings = (rendered?.headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);
const minutes = entry ? readingMinutes(entry.body) : 0;

const pos = readingOrder.findIndex((r) => r.phase.slug === phase.slug && r.chapter.slug === chapter.slug);
const prev = readingOrder[pos - 1];
const next = readingOrder[pos + 1];
const label = `${pad(phase.num)}.${pad(index + 1)}`;
---
<Base title={chapter.title} description={entry?.data.description ?? chapter.summary} active="phases">
  <div class="read-progress" aria-hidden="true"><span id="read-bar"></span></div>

  <div class="layout">
    <!-- Left: chapters in this phase -->
    <aside class="sidebar">
      <details class="side-box" open>
        <summary class="side-head">
          <span class="eyebrow">Phase {pad(phase.num)}</span>
          <span class="side-title">{phase.title}</span>
        </summary>
        <ol class="side-list">
          {phase.chapters.map((c, i) => {
            const cid = `${phase.slug}/${c.slug}`;
            return (
              <li data-chapter-id={cid} class:list={[{ current: c.slug === chapter.slug, planned: !ready.has(cid) }]}>
                <a href={`/${cid}`} aria-current={c.slug === chapter.slug ? 'page' : undefined}>
                  <span class="mono sn">{pad(i + 1)}</span>
                  <span class="st">{c.title}</span>
                </a>
              </li>
            );
          })}
        </ol>
        <div class="side-phases">
          {phases.map((p) => (
            <a href={`/${p.slug}`} class:list={['mono', { on: p.slug === phase.slug }]} title={p.title}>{pad(p.num)}</a>
          ))}
        </div>
      </details>
    </aside>

    <!-- Center: the chapter -->
    <article class="article">
      <header class="ch-head">
        <nav class="crumbs mono" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href={`/${phase.slug}`}>Phase {pad(phase.num)} · {phase.title}</a><span>/</span><span>Chapter {label}</span>
        </nav>
        <h1>{chapter.title}</h1>
        <p class="ch-lead">{entry?.data.description ?? chapter.summary}</p>
        <div class="ch-meta">
          <LevelBadge level={chapter.level} />
          {entry && <span class="tag">{minutes} min read</span>}
          <span class="tag">Chapter {index + 1} of {phase.chapters.length}</span>
          {!entry && <span class="tag soon">Coming soon</span>}
        </div>
      </header>

      {Content ? (
        <div class="prose">
          <Content />
        </div>
      ) : (
        <div class="soon-box card bracket">
          <span class="eyebrow">This chapter is being written</span>
          <h2>What you will learn here</h2>
          <ul>
            {chapter.learn.map((l) => <li>{l}</li>)}
          </ul>
          <p class="muted">Until it is ready, start with the chapters that are already available in this phase.</p>
          <a class="btn btn-primary btn-sm" href={`/${phase.slug}`}>See phase {phase.num}</a>
        </div>
      )}

      {entry && (
        <div class="done-row card">
          <div>
            <strong>Finished this chapter?</strong>
            <p class="muted">Mark it as read to track your progress on the roadmap. Saved only in this browser.</p>
          </div>
          <button class="btn btn-ghost" id="mark-read" type="button" data-id={id}>Mark as read</button>
        </div>
      )}

      <nav class="pager">
        {prev ? (
          <a class="pg card" href={`/${prev.phase.slug}/${prev.chapter.slug}`}>
            <span class="mono">← Previous</span>
            <strong>{prev.chapter.title}</strong>
          </a>
        ) : <span />}
        {next ? (
          <a class="pg card right" href={`/${next.phase.slug}/${next.chapter.slug}`}>
            <span class="mono">Next →</span>
            <strong>{next.chapter.title}</strong>
          </a>
        ) : <span />}
      </nav>
    </article>

    <!-- Right: on this page -->
    <aside class="toc">
      {headings.length > 0 && (
        <div class="toc-box">
          <span class="toc-label mono">On this page</span>
          <ol>
            {headings.map((h) => (
              <li class={`d${h.depth}`}><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>
            ))}
          </ol>
        </div>
      )}
    </aside>
  </div>
</Base>

<script>
  // Reading progress bar
  const bar = document.getElementById('read-bar');
  const article = document.querySelector<HTMLElement>('.article');
  function onScroll() {
    if (!bar || !article) return;
    const rect = article.getBoundingClientRect();
    const total = article.offsetHeight - window.innerHeight;
    const p = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
    bar.style.transform = `scaleX(${p})`;
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Highlight the current section in "On this page"
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
  const targets = links
    .map((l) => document.getElementById(l.dataset.toc!))
    .filter((el): el is HTMLElement => !!el);
  if (targets.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((l) => l.classList.toggle('active', l.dataset.toc === e.target.id));
          }
        });
      },
      { rootMargin: '-80px 0px -70% 0px' },
    );
    targets.forEach((t) => observer.observe(t));
  }

  // Progress saved in this browser
  const KEY = 'llmbook-read';
  function load(): string[] {
    try {
      return JSON.parse(localStorage.getItem(KEY) || '[]');
    } catch {
      return [];
    }
  }
  function save(list: string[]) {
    try {
      localStorage.setItem(KEY, JSON.stringify(list));
    } catch {}
  }
  function paint() {
    const done = new Set(load());
    document.querySelectorAll<HTMLElement>('[data-chapter-id]').forEach((el) => {
      el.classList.toggle('done', done.has(el.dataset.chapterId!));
    });
    const btn = document.getElementById('mark-read');
    if (btn) {
      const isDone = done.has(btn.dataset.id!);
      btn.textContent = isDone ? '✓ Read' : 'Mark as read';
      btn.classList.toggle('is-done', isDone);
    }
  }
  document.getElementById('mark-read')?.addEventListener('click', (e) => {
    const id = (e.currentTarget as HTMLElement).dataset.id!;
    const list = load();
    const i = list.indexOf(id);
    if (i === -1) list.push(id);
    else list.splice(i, 1);
    save(list);
    paint();
  });
  paint();
</script>

<style>
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 60;
    pointer-events: none;
  }
  #read-bar {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .layout {
    max-width: 1320px;
    margin: 0 auto;
    padding: 40px 24px 40px;
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr) 220px;
    gap: 48px;
    align-items: start;
  }

  /* Sidebar */
  .sidebar { position: sticky; top: 84px; max-height: calc(100vh - 100px); overflow-y: auto; }
  .side-box summary { list-style: none; cursor: default; }
  .side-box summary::-webkit-details-marker { display: none; }
  .side-head { display: flex; flex-direction: column; gap: 6px; padding-bottom: 14px; border-bottom: 1px solid var(--border); }
  .side-title { font-weight: 700; font-size: 15px; }
  .side-list { list-style: none; padding: 10px 0; margin: 0; }
  .side-list a {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 6px;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--text-2);
    text-decoration: none;
  }
  .side-list a:hover { background: var(--surface); color: var(--text); }
  .side-list .sn { font-size: 11px; color: var(--text-3); padding-top: 2px; }
  .side-list .current a { background: var(--accent-soft); color: var(--accent-text); font-weight: 600; }
  .side-list .current .sn { color: var(--accent-text); }
  .side-list .planned a { color: var(--text-3); }
  .side-list .done .sn::after { content: ' ✓'; color: var(--green); }
  .side-phases { display: flex; gap: 6px; padding-top: 14px; border-top: 1px solid var(--border); }
  .side-phases a {
    flex: 1;
    text-align: center;
    padding: 5px 0;
    font-size: 11.5px;
    border: 1px solid var(--border);
    border-radius: 7px;
    color: var(--text-3);
    background: var(--surface);
    text-decoration: none;
  }
  .side-phases a.on { color: var(--accent-text); border-color: var(--accent); }

  /* Article */
  .article { max-width: var(--prose-width); width: 100%; margin: 0 auto; min-width: 0; }
  .ch-head { padding-bottom: 28px; margin-bottom: 8px; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 11.5px; color: var(--text-3); margin-bottom: 22px; }
  .crumbs a { color: var(--text-3); }
  .crumbs a:hover { color: var(--accent-text); }
  h1 { font-size: clamp(30px, 4.6vw, 44px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
  .ch-lead { margin-top: 16px; font-size: 18px; color: var(--text-2); line-height: 1.6; }
  .ch-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 20px; }
  .ch-meta .soon { color: var(--amber); }

  .soon-box { padding: 28px; margin-top: 12px; }
  .soon-box h2 { font-size: 22px; margin: 10px 0 12px; }
  .soon-box ul { margin: 0 0 16px; padding-left: 20px; display: grid; gap: 6px; }
  .soon-box p { margin-bottom: 16px; font-size: 14px; }

  .done-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    margin-top: 56px;
  }
  .done-row p { font-size: 13.5px; margin-top: 2px; }
  :global(#mark-read.is-done) { color: var(--green); border-color: var(--green); background: var(--green-soft); }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; }
  .pg { padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; color: inherit; text-decoration: none !important; }
  .pg:hover { border-color: var(--accent); }
  .pg span { font-size: 11.5px; color: var(--accent-text); }
  .pg strong { font-size: 14.5px; }
  .pg.right { text-align: right; }

  /* TOC */
  .toc { position: sticky; top: 84px; max-height: calc(100vh - 100px); overflow-y: auto; }
  .toc-label { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-3); }
  .toc ol { list-style: none; padding: 0; margin: 12px 0 0; border-left: 1px solid var(--border); }
  .toc li a {
    display: block;
    padding: 5px 0 5px 14px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-3);
    text-decoration: none;
  }
  .toc li.d3 a { padding-left: 26px; font-size: 12.5px; }
  .toc li a:hover { color: var(--text); }
  .toc li a.active { color: var(--accent-text); border-left-color: var(--accent); }

  /* Reading mode: one calm column */
  :global(:root[data-theme='reading']) .layout { grid-template-columns: minmax(0, 1fr); max-width: 860px; }
  :global(:root[data-theme='reading']) .sidebar,
  :global(:root[data-theme='reading']) .toc { display: none; }
  :global(:root[data-theme='reading']) h1 { font-family: var(--font-body); font-weight: 600; letter-spacing: -0.01em; }
  :global(:root[data-theme='reading']) .ch-lead { font-family: var(--font-body); font-style: italic; }

  @media (max-width: 1180px) {
    .layout { grid-template-columns: 230px minmax(0, 1fr); gap: 36px; }
    .toc { display: none; }
  }
  @media (max-width: 860px) {
    .layout { grid-template-columns: minmax(0, 1fr); padding: 20px 16px 32px; gap: 20px; }
    .sidebar { position: static; max-height: none; }
    .side-box { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); padding: 12px 14px; }
    .side-box summary { cursor: pointer; }
    .side-box:not([open]) .side-head { border-bottom: 0; padding-bottom: 0; }
    .done-row { flex-direction: column; align-items: flex-start; }
    .pager { grid-template-columns: 1fr; }
    .pg.right { text-align: left; }
  }
</style>

<script>
  // On small screens, start with the chapter list closed.
  if (window.matchMedia('(max-width: 860px)').matches) {
    document.querySelector('.side-box')?.removeAttribute('open');
  }
</script>
