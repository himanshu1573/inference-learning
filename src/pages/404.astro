---
import Base from '../layouts/Base.astro';
import CircuitBg from '../components/CircuitBg.astro';
---
<Base title="Page not found">
  <section class="nf grid-bg">
    <CircuitBg />
    <div class="container inner">
      <span class="eyebrow">Error 404</span>
      <h1>This page is <span class="accent">not loaded</span>.</h1>
      <p>Like a token that is not in the KV cache, this page is missing. It may have moved, or the link may be wrong.</p>
      <div class="row">
        <a class="btn btn-primary" href="/">Back to the roadmap</a>
        <a class="btn btn-ghost" href="/gpu-hardware/what-is-inference">Start reading</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { position: relative; overflow: hidden; padding: 120px 0; }
  .inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; }
  h1 { font-size: clamp(32px, 5vw, 52px); font-weight: 800; letter-spacing: -0.03em; }
  p { color: var(--text-2); max-width: 480px; }
  .row { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
</style>
