---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  active?: string;
}
const { title, description = 'How large language models are served, from GPU hardware to Kubernetes, explained in simple English.', active } = Astro.props;
const fullTitle = title === 'The LLM Inference Book' ? title : `${title} · The LLM Inference Book`;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Set the theme before the first paint so there is no flash. -->
    <script is:inline>
      (function () {
        var t;
        try { t = new URLSearchParams(location.search).get('theme') || localStorage.getItem('llmbook-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark' && t !== 'reading') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
