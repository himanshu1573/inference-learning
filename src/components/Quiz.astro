---
// A "check yourself" question with a hidden answer.
interface Props { q: string; n?: number }
const { q, n } = Astro.props;
---
<details class="quiz">
  <summary>
    <span class="q-tag mono">{n ? `Q${String(n).padStart(2, '0')}` : 'Check'}</span>
    <span class="q-text">{q}</span>
    <span class="q-show mono">Show answer</span>
  </summary>
  <div class="answer"><slot /></div>
</details>
<style>
  .quiz {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin: 0 !important;
  }
  .quiz + :global(.quiz) { border-top: 0; }
  summary {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 14px 4px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  .q-tag { font-size: 11.5px; color: var(--accent-text); font-weight: 600; flex: none; }
  .q-text { font-weight: 600; font-family: 'Inter', ui-sans-serif, sans-serif; font-size: 0.95em; flex: 1; }
  .q-show { font-size: 11px; color: var(--text-3); flex: none; }
  details[open] .q-show { visibility: hidden; }
  .answer { padding: 0 4px 16px 44px; color: var(--text-2); font-size: 0.95em; }
  .answer > :global(* + *) { margin-top: 0.6em; }
</style>
