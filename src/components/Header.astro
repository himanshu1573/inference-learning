---
import Logo from './Logo.astro';
import ThemeSwitch from './ThemeSwitch.astro';
interface Props { active?: string }
const { active } = Astro.props;
const links = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/#roadmap', label: 'Roadmap', key: 'roadmap' },
  { href: '/#phases', label: 'Phases', key: 'phases' },
  { href: '/#faq', label: 'FAQ', key: 'faq' },
];
---
<header class="site-header">
  <div class="bar">
    <Logo />
    <nav class="nav-pill" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class={active === l.key ? 'active' : ''} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="right">
      <ThemeSwitch />
      <a href="/gpu-hardware/why-gpus" class="btn btn-primary btn-sm start">Start reading</a>
    </div>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }
  .bar {
    max-width: 1320px;
    margin: 0 auto;
    padding: 12px 24px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }
  .nav-pill {
    display: flex;
    gap: 2px;
    padding: 4px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
  }
  .nav-pill a {
    padding: 6px 14px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-2);
    border-radius: 8px;
    text-decoration: none;
  }
  .nav-pill a:hover { color: var(--text); background: var(--surface-3); }
  .nav-pill a.active { color: var(--accent-text); background: var(--accent-soft); }
  .right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
  }
  @media (max-width: 860px) {
    .bar { grid-template-columns: 1fr auto; padding: 10px 16px; }
    .nav-pill { display: none; }
  }
  @media (max-width: 480px) {
    .start { display: none; }
  }
</style>
