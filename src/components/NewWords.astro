---
// "New words" box at the start of a chapter: simple meanings for new terms.
interface Props { words: { word: string; meaning: string }[] }
const { words } = Astro.props;
---
<section class="new-words card">
  <div class="nw-head">
    <span class="eyebrow">New words in this chapter</span>
    <span class="count mono">{words.length} terms</span>
  </div>
  <dl>
    {words.map((w) => (
      <div class="row">
        <dt>{w.word}</dt>
        <dd>{w.meaning}</dd>
      </div>
    ))}
  </dl>
</section>
<style>
  .new-words { margin: 2em 0; padding: 18px 20px 8px; }
  .nw-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .count { font-size: 11.5px; color: var(--text-3); }
  dl { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 28px; }
  .row { padding: 10px 0; border-top: 1px dashed var(--border); }
  dt { font-weight: 700; font-size: 0.92em; color: var(--text); font-family: 'Inter', ui-sans-serif, sans-serif; }
  dd { margin: 3px 0 0; font-size: 0.88em; color: var(--text-2); line-height: 1.55; }
  @media (max-width: 640px) { dl { grid-template-columns: 1fr; } }
</style>
