---
// One request on a timeline: queue, prefill, then decode tokens. TTFT, TPOT and E2E latency.
const t0 = 40;      // request sent
const qEnd = 104;   // leaves the queue
const pEnd = 236;   // prefill done = first token
const step = 38;    // TPOT in px
const ticks = Array.from({ length: 12 }, (_, i) => pEnd + i * step);
const last = ticks[ticks.length - 1];
---
<svg viewBox="0 0 720 270" role="img" aria-label="Timeline of one request: it waits in a queue, then prefill runs and produces the first token, then decode produces one token per step. TTFT is from sending the request to the first token. TPOT is the gap between tokens. End-to-end latency is from sending to the last token.">
  <defs>
    <marker id="mrt-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="t3" /></marker>
  </defs>
  <!-- phase bands -->
  <rect x={t0} y="70" width={qEnd - t0} height="44" rx="6" class="box2" />
  <text x={(t0 + qEnd) / 2} y="97" class="t2" font-size="11.5" text-anchor="middle">queue</text>
  <rect x={qEnd} y="70" width={pEnd - qEnd} height="44" rx="6" class="box-a" />
  <text x={(qEnd + pEnd) / 2} y="92" class="ta" font-size="12" font-weight="700" text-anchor="middle">prefill</text>
  <text x={(qEnd + pEnd) / 2} y="106" class="t2" font-size="10.5" text-anchor="middle">reads whole prompt</text>
  <rect x={pEnd} y="70" width={last - pEnd} height="44" rx="6" class="teal" />
  <text x={(pEnd + last) / 2} y="62" class="tt" font-size="12" font-weight="700" text-anchor="middle">decode: one token per step</text>
  {ticks.map((x, i) => (
    <g>
      <line x1={x} y1="70" x2={x} y2="114" class="sg" style="stroke: var(--teal)" stroke-width={i === 0 ? 2.5 : 1.5} />
      <circle cx={x} cy="92" r="4" class="tt" />
    </g>
  ))}

  <!-- event labels -->
  <text x={t0} y="30" class="t" font-size="11.5" font-weight="600" text-anchor="middle">request sent</text>
  <line x1={t0} y1="36" x2={t0} y2="68" class="line-t" stroke-dasharray="3 3" />
  <text x={pEnd} y="30" class="tt" font-size="11.5" font-weight="700" text-anchor="middle">first token</text>
  <line x1={pEnd} y1="36" x2={pEnd} y2="50" class="line-t" stroke-dasharray="3 3" />
  <text x={last} y="30" class="t" font-size="11.5" font-weight="600" text-anchor="middle">last token</text>
  <line x1={last} y1="36" x2={last} y2="50" class="line-t" stroke-dasharray="3 3" />

  <!-- time axis -->
  <path d="M30 136 H700" class="line-t" stroke-width="1.2" marker-end="url(#mrt-a)" />
  <text x="700" y="154" class="t3 mono" font-size="10.5" text-anchor="end">time →</text>

  <!-- TTFT -->
  <path d={`M${t0} 168 V180 M${pEnd} 168 V180 M${t0} 174 H${pEnd}`} class="line-a" stroke-width="1.6" />
  <text x={(t0 + pEnd) / 2} y="198" class="ta" font-size="12" font-weight="700" text-anchor="middle">TTFT</text>
  <text x={(t0 + pEnd) / 2} y="213" class="t3" font-size="10.5" text-anchor="middle">queue + prefill</text>

  <!-- TPOT -->
  <path d={`M${ticks[3]} 168 V180 M${ticks[4]} 168 V180 M${ticks[3]} 174 H${ticks[4]}`} class="line-a" stroke-width="1.6" />
  <text x={(ticks[3] + ticks[4]) / 2} y="198" class="ta" font-size="12" font-weight="700" text-anchor="middle">TPOT</text>
  <text x={(ticks[3] + ticks[4]) / 2} y="213" class="t3" font-size="10.5" text-anchor="middle">gap between tokens</text>

  <!-- E2E -->
  <path d={`M${t0} 230 V242 M${last} 230 V242 M${t0} 236 H${last}`} class="line-t" stroke-width="1.4" />
  <text x={(t0 + last) / 2} y="258" class="t" font-size="12" font-weight="700" text-anchor="middle">end-to-end latency = TTFT + TPOT × (number of output tokens − 1)</text>
</svg>
