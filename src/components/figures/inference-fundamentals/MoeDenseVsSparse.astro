---
// Dense MLP layer vs a Mixture-of-Experts layer (8 experts, top-2).
const experts = [0, 1, 2, 3, 4, 5, 6, 7];
const active = [0, 5];
const ex = (i: number) => 392 + i * 38;
---
<svg viewBox="0 0 720 312" role="img" aria-label="Left: a dense layer where every token goes through one big MLP. Right: a mixture-of-experts layer where a router sends each token to 2 of 8 small experts, and their outputs are added together.">
  <defs>
    <marker id="mdvs-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="fill-a" /></marker>
    <marker id="mdvs-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="t3" /></marker>
  </defs>

  <!-- Dense side -->
  <text x="170" y="22" class="t" font-size="13.5" font-weight="700" text-anchor="middle">Dense layer</text>
  <text x="170" y="39" class="t3" font-size="11" text-anchor="middle">like Llama 3.1 8B</text>
  <rect x="120" y="52" width="100" height="28" rx="14" class="box" />
  <text x="170" y="70" class="t2 mono" font-size="11.5" text-anchor="middle">token</text>
  <path d="M170 82 V108" class="line-a" stroke-width="1.5" marker-end="url(#mdvs-a)" />
  <rect x="50" y="112" width="240" height="90" rx="12" class="box-a" />
  <text x="170" y="150" class="t" font-size="14" font-weight="700" text-anchor="middle">One big MLP</text>
  <text x="170" y="170" class="t2" font-size="11.5" text-anchor="middle">all of its weights are used</text>
  <text x="170" y="186" class="t2" font-size="11.5" text-anchor="middle">for every token</text>
  <path d="M170 204 V238" class="line-a" stroke-width="1.5" marker-end="url(#mdvs-a)" />
  <rect x="120" y="242" width="100" height="28" rx="14" class="box" />
  <text x="170" y="260" class="t2 mono" font-size="11.5" text-anchor="middle">output</text>
  <text x="170" y="298" class="ta" font-size="12" font-weight="600" text-anchor="middle">work per token = whole MLP</text>

  <line x1="355" y1="20" x2="355" y2="300" class="line" stroke-dasharray="3 5" />

  <!-- MoE side -->
  <text x="541" y="22" class="t" font-size="13.5" font-weight="700" text-anchor="middle">Mixture-of-Experts layer</text>
  <text x="541" y="39" class="t3" font-size="11" text-anchor="middle">like Mixtral 8x7B: 8 experts, top-2</text>
  <rect x="491" y="52" width="100" height="28" rx="14" class="box" />
  <text x="541" y="70" class="t2 mono" font-size="11.5" text-anchor="middle">token</text>
  <path d="M541 82 V94" class="line-a" stroke-width="1.5" />
  <rect x="476" y="94" width="130" height="30" rx="8" class="violet" />
  <text x="541" y="114" class="tv" font-size="12" font-weight="700" text-anchor="middle">Router (gate)</text>

  {experts.map((i) => {
    const on = active.includes(i);
    return (
      <g>
        <path d={`M541 126 L${ex(i) + 16} 154`} class={on ? 'line-a' : 'line'} stroke-width={on ? 1.6 : 1} stroke-dasharray={on ? '' : '3 4'} />
        <rect x={ex(i)} y="156" width="32" height="44" rx="6" class={on ? 'box-a' : 'box'} style={on ? '' : 'opacity: 0.55'} />
        <text x={ex(i) + 16} y="183" class={on ? 'ta mono' : 't3 mono'} font-size="11.5" font-weight="600" text-anchor="middle">E{i + 1}</text>
      </g>
    );
  })}
  {active.map((i) => (
    <path d={`M${ex(i) + 16} 202 L541 230`} class="line-a" stroke-width="1.6" />
  ))}
  <circle cx="541" cy="236" r="10" class="box-a" />
  <text x="541" y="240.5" class="ta" font-size="14" font-weight="700" text-anchor="middle">+</text>
  <text x="560" y="240" class="t3" font-size="10.5">weighted sum</text>
  <path d="M541 248 V258" class="line-a" stroke-width="1.5" marker-end="url(#mdvs-a)" />
  <rect x="491" y="260" width="100" height="24" rx="12" class="box" />
  <text x="541" y="276" class="t2 mono" font-size="11.5" text-anchor="middle">output</text>
  <text x="541" y="302" class="ta" font-size="12" font-weight="600" text-anchor="middle">work per token = only 2 small experts</text>
</svg>
