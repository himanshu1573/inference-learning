---
// The sampling pipeline: logits -> penalties -> temperature -> filters -> softmax -> draw -> token.
const steps = [
  { t: 'Logits', s: '128,256 scores', cls: 'box' },
  { t: 'Penalties', s: 'fewer repeats', cls: 'box' },
  { t: 'Temperature', s: 'divide by T', cls: 'box-a' },
  { t: 'Filters', s: 'top-k / top-p', cls: 'box-a' },
  { t: 'Softmax', s: 'scores → chances', cls: 'box' },
  { t: 'Random draw', s: 'roll the dice', cls: 'box' },
  { t: 'Token', s: '“ pizza”', cls: 'green' },
];
const w = 90;
const gap = 11;
---
<svg viewBox="0 0 720 170" role="img" aria-label="Sampling pipeline: logits, penalties, temperature, filters, softmax, random draw, token">
  <defs>
    <marker id="smpp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="fill-a" /></marker>
  </defs>
  {steps.map((s, i) => {
    const x = 10 + i * (w + gap);
    return (
      <g>
        <text x={x + w / 2} y="34" class="t3 mono" font-size="10" text-anchor="middle">{String(i + 1).padStart(2, '0')}</text>
        <rect x={x} y="44" width={w} height="66" rx="10" class={s.cls} />
        <text x={x + w / 2} y="73" class={s.cls === 'green' ? 'tg' : 't'} font-size="12" font-weight="700" text-anchor="middle">{s.t}</text>
        <text x={x + w / 2} y="92" class="t2" font-size="9.5" text-anchor="middle">{s.s}</text>
        {i < steps.length - 1 && <path d={`M${x + w + 1} 77 H${x + w + gap - 1}`} class="line-a" stroke-width="1.5" marker-end="url(#smpp-arrow)" />}
      </g>
    );
  })}
  <text x="10" y="140" class="t2" font-size="11.5">Steps 2 to 4 are optional settings. With temperature 0, steps 4 to 6 become “take the highest score” (greedy).</text>
  <text x="10" y="158" class="t3" font-size="11">This order is typical; engines differ slightly in details.</text>
</svg>
