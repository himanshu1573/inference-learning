---
// HBM traffic for one attention head (N = 8,192, d = 128, BF16).
const rows = [
  { name: 'Naive attention', sub: 'S and P written and read back', mb: 545, cls: 'red', tc: 'tr' },
  { name: 'FlashAttention, no cache help', sub: 'K, V re-read for each of 64 Q blocks', mb: 272, cls: 'amber', tc: 'tam' },
  { name: 'FlashAttention, ideal', sub: 'read Q, K, V once, write O once', mb: 8.4, cls: 'green', tc: 'tg' },
];
const x0 = 250, scale = 0.68;
---
<svg viewBox="0 0 720 230" role="img" aria-label="HBM traffic for one head: naive attention about 545 MB, FlashAttention with every repeated read going to HBM about 272 MB, FlashAttention ideal about 8.4 MB">
  <text x="20" y="24" class="t" font-size="13" font-weight="700">HBM traffic for one head of one layer</text>
  <text x="20" y="42" class="t3" font-size="11">N = 8,192 tokens, head size 128, BF16</text>
  {rows.map((r, i) => {
    const y = 64 + i * 48;
    const w = Math.max(4, r.mb * scale);
    return (
      <g>
        <text x={x0 - 12} y={y + 13} class="t" font-size="12" font-weight="600" text-anchor="end">{r.name}</text>
        <text x={x0 - 12} y={y + 28} class="t3" font-size="10.5" text-anchor="end">{r.sub}</text>
        <rect x={x0} y={y} width={w} height="26" rx="4" class={r.cls} />
        <text x={x0 + w + 8} y={y + 18} class={`${r.tc} mono`} font-size="12" font-weight="700">{r.mb} MB</text>
      </g>
    );
  })}
  <text x="20" y="218" class="t3" font-size="11">On real GPUs, many repeated K and V reads hit the 50 MB L2 cache, so real traffic is much closer to the ideal.</text>
</svg>
