---
// Tokens produced per verify step when α = 0.8 and k = 4.
const a = 0.8, k = 4;
const probs = Array.from({ length: k + 1 }, (_, n) => (n < k ? a ** n * (1 - a) : a ** k));
const E = (1 - a ** (k + 1)) / (1 - a);
const H = 150, X0 = 90, bw = 90;
const yOf = (p: number) => 200 - (p / 0.45) * H;
---
<svg viewBox="0 0 720 270" role="img" aria-label="With acceptance rate 0.8 and 4 draft tokens, one step produces 1 token with probability 0.2, 2 with 0.16, 3 with 0.128, 4 with 0.102 and 5 with 0.41. The average is 3.36 tokens.">
  <text x="20" y="24" class="t" font-size="13" font-weight="700">Tokens produced in one step (α = 0.8, k = 4)</text>
  <path d={`M${X0 - 10} 200 H${X0 + 5 * (bw + 20)}`} class="line" />
  {probs.map((p, n) => (
    <g>
      <rect x={X0 + n * (bw + 20)} y={yOf(p)} width={bw} height={200 - yOf(p)} rx="5" class={n === k ? 'green' : 'box-a'} />
      <text x={X0 + n * (bw + 20) + bw / 2} y={yOf(p) - 8} class="t mono" font-size="12" font-weight="700" text-anchor="middle">{p.toFixed(3)}</text>
      <text x={X0 + n * (bw + 20) + bw / 2} y="220" class="t2 mono" font-size="12" text-anchor="middle">{n + 1} token{n ? 's' : ''}</text>
      <text x={X0 + n * (bw + 20) + bw / 2} y="236" class="t3" font-size="10.5" text-anchor="middle">{n === k ? 'all 4 accepted' : `${n} accepted`}</text>
    </g>
  ))}
  <text x="20" y="262" class="t2" font-size="12">Average = 1(0.2) + 2(0.16) + 3(0.128) + 4(0.1024) + 5(0.4096) = <tspan class="ta mono" font-weight="700">{E.toFixed(2)} tokens per step</tspan></text>
</svg>
