---
// CUDA Graphs need fixed shapes: the engine records graphs for a list of batch sizes and pads.
const sizes = [1, 2, 4, 8, 16, 24, 32, 40, 48, 56, 64];
---
<svg viewBox="0 0 720 260" role="img" aria-label="The engine records one CUDA Graph for each of several batch sizes. A batch of 13 requests runs with the graph for 16, with 3 empty padding slots.">
  <defs>
    <marker id="kgb-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="fill-a" /></marker>
  </defs>
  <text x="20" y="26" class="t" font-size="13" font-weight="700">Graphs recorded at startup, one per batch size</text>
  {sizes.map((s, i) => (
    <g>
      <rect x={20 + i * 58} y="42" width="50" height="38" rx="8" class={s === 16 ? 'box-a' : 'box'} />
      <text x={45 + i * 58} y="66" class={s === 16 ? 'ta mono' : 't2 mono'} font-size="13" font-weight="700" text-anchor="middle">{s}</text>
    </g>
  ))}
  <text x="686" y="66" class="t3 mono" font-size="13">…</text>

  <text x="20" y="128" class="t" font-size="13" font-weight="700">Now 13 requests are running</text>
  {Array.from({ length: 16 }, (_, i) => (
    <rect x={20 + i * 26} y="142" width="22" height="30" rx="4" class={i < 13 ? 'fill-a' : 'box'} stroke-dasharray={i < 13 ? undefined : '3 2'} />
  ))}
  <text x="20" y="192" class="t2" font-size="11.5"><tspan class="ta" font-weight="700">13 real</tspan> requests + <tspan class="t" font-weight="700">3 padding</tspan> slots = use the graph for 16</text>
  <path d="M440 156 C 500 156, 515 120, 515 88" class="line-a" stroke-width="1.5" marker-end="url(#kgb-arrow)" />

  <rect x="20" y="210" width="680" height="38" rx="9" class="box2" />
  <text x="36" y="234" class="t2" font-size="12">Padding wastes a little math, but decode is memory-bound, so 16 rows cost about the same as 13.</text>
</svg>
