---
// Per-tensor vs per-channel vs per-group scales on one weight matrix.
const rows = 6, cols = 12, cw = 15, ch = 15;
const panels = [
  { x: 20, title: 'Per-tensor', sub: '1 scale for everything' },
  { x: 260, title: 'Per-channel', sub: '1 scale per output row' },
  { x: 500, title: 'Per-group (g = 128)', sub: '1 scale per 128 inputs in a row' },
];
const tints = ['box-a', 'green', 'amber', 'violet', 'teal', 'red'];
---
<svg viewBox="0 0 720 250" role="img" aria-label="Three ways to share scales in a weight matrix: one scale for the whole matrix, one per row, or one per group of 128 values in each row">
  {panels.map((p, pi) => (
    <g>
      <text x={p.x} y="24" class="t" font-size="13" font-weight="700">{p.title}</text>
      <text x={p.x} y="42" class="t3" font-size="11">{p.sub}</text>
      {Array.from({ length: rows * cols }, (_, i) => {
        const r = Math.floor(i / cols), c = i % cols;
        let cls = 'box-a';
        if (pi === 1) cls = tints[r % tints.length];
        if (pi === 2) cls = tints[(r * 3 + Math.floor(c / 4)) % tints.length];
        return <rect x={p.x + c * (cw + 2)} y={58 + r * (ch + 2)} width={cw} height={ch} rx="2" class={cls} />;
      })}
      {pi === 2 && [4, 8].map((c) => (
        <path d={`M${p.x + c * (cw + 2) - 1} 54 V${58 + rows * (ch + 2)}`} class="line-t" stroke-width="1.6" />
      ))}
    </g>
  ))}
  <text x="20" y="190" class="t2" font-size="11.5">1 scale per matrix</text>
  <text x="260" y="190" class="t2" font-size="11.5">4,096 scales for a 4096 × 4096 matrix</text>
  <text x="500" y="190" class="t2" font-size="11.5">4,096 × 32 = 131,072 scales</text>
  <text x="20" y="222" class="t" font-size="12" font-weight="600">More scales = smaller errors (each group gets a scale that fits it) but more memory and more work.</text>
  <text x="20" y="240" class="t3" font-size="11">In the picture each colour is one scale. Groups are drawn smaller than 128 so they fit.</text>
</svg>
