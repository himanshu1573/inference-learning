---
// Different pairs rotate at different speeds. Hands show the angle at position 100.
const pairs = [
  { i: 0, theta: 1.0, wave: '6.3 tokens' },
  { i: 16, theta: 0.0376, wave: '167 tokens' },
  { i: 32, theta: 0.001414, wave: '4,443 tokens' },
  { i: 63, theta: 0.000002455, wave: '2.6 million tokens' },
];
const P = 100;
---
<svg viewBox="0 0 720 260" role="img" aria-label="Four clock faces: pair 0 rotates fast, pair 63 rotates extremely slowly. The hands show the angle at position 100.">
  {pairs.map((p, k) => {
    const cx = 100 + k * 172, cy = 110, r = 58;
    const ang = (P * p.theta) % (2 * Math.PI);
    const x = cx + r * Math.cos(ang), y = cy - r * Math.sin(ang);
    return (
      <g>
        <circle cx={cx} cy={cy} r={r} class={k === 0 ? 'box-a' : 'box'} />
        <path d={`M${cx} ${cy} H${cx + r}`} class="line" stroke-dasharray="3 3" />
        <path d={`M${cx} ${cy} L${x} ${y}`} class="line-a" stroke-width="2.4" stroke-linecap="round" />
        <circle cx={cx} cy={cy} r="3.5" class="fill-a" />
        <text x={cx} y="28" class="t mono" font-size="11.5" font-weight="700" text-anchor="middle">pair {p.i}</text>
        <text x={cx} y="196" class="t2" font-size="10.5" text-anchor="middle">one full turn every</text>
        <text x={cx} y="212" class="ta mono" font-size="11" font-weight="700" text-anchor="middle">{p.wave}</text>
        <text x={cx} y="230" class="t3 mono" font-size="10" text-anchor="middle">angle at pos 100: {(ang * 180 / Math.PI).toFixed(ang < 0.01 ? 3 : 0)}°</text>
      </g>
    );
  })}
  <text x="16" y="254" class="t3" font-size="10.5">Llama 3.1: head dimension 128 → 64 pairs, base θ = 500,000. Fast pairs see nearby order; slow pairs see far distances.</text>
</svg>
