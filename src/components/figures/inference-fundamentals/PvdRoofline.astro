---
// H100 roofline with three points: decode batch 1, decode batch 64, prefill of 2000 tokens.
const L = 74, R = 690, T = 24, B = 250;
const xMin = -0.3, xMax = 4, yMax = 3.5;
const px = (ai: number) => L + ((Math.log10(ai) - xMin) / (xMax - xMin)) * (R - L);
const py = (t: number) => B - (Math.log10(t) / yMax) * (B - T);
const peak = 989, bw = 3.35, ridge = peak / bw;
const att = (ai: number) => Math.min(peak, bw * ai);
const roof = `M${L} ${py(bw * 10 ** xMin)} L${px(ridge)} ${py(peak)} H${R}`;
const pts = [
  { ai: 1, label: 'decode, batch 1', sub: '≈ 3.4 TFLOPS (0.3%)', dx: 12, dy: 4, anchor: 'start' },
  { ai: 64, label: 'decode, batch 64', sub: '≈ 214 TFLOPS (22%)', dx: 12, dy: 18, anchor: 'start' },
  { ai: 1000, label: 'prefill, 2,000 tokens', sub: 'intensity ≈ 1,000', dx: 14, dy: 30, anchor: 'start' },
];
const xt = [1, 10, 100, 1000, 10000];
const yt = [1, 10, 100, 1000];
---
<svg viewBox="0 0 720 300" role="img" aria-label="Roofline of an H100. Decode at batch 1 has intensity 1 and gets about 3.4 TFLOPS. Decode at batch 64 has intensity 64 and gets about 214 TFLOPS. Prefill of 2000 tokens has intensity about 1000 and reaches the compute roof of 989 TFLOPS">
  <rect x={L} y={T} width={px(ridge) - L} height={B - T} class="amber" style="stroke:none; opacity:0.45" />
  <rect x={px(ridge)} y={T} width={R - px(ridge)} height={B - T} class="green" style="stroke:none; opacity:0.45" />
  {xt.map((v) => (
    <g>
      <line x1={px(v)} y1={T} x2={px(v)} y2={B} class="line" stroke-dasharray="2 4" />
      <text x={px(v)} y={B + 16} class="t3 mono" font-size="10.5" text-anchor="middle">{v.toLocaleString('en-US')}</text>
    </g>
  ))}
  {yt.map((v) => (
    <g>
      <line x1={L} y1={py(v)} x2={R} y2={py(v)} class="line" stroke-dasharray="2 4" />
      <text x={L - 8} y={py(v) + 4} class="t3 mono" font-size="10.5" text-anchor="end">{v.toLocaleString('en-US')}</text>
    </g>
  ))}
  <rect x={L} y={T} width={R - L} height={B - T} class="line" />
  <path d={roof} class="line-a" stroke-width="3" stroke-linejoin="round" />
  <line x1={px(ridge)} y1={py(peak)} x2={px(ridge)} y2={B} class="line-t" stroke-dasharray="5 4" />
  <text x={px(ridge) + 6} y={B - 8} class="t mono" font-size="10.5" font-weight="600">ridge ≈ 295</text>
  {pts.map((p) => (
    <g>
      <circle cx={px(p.ai)} cy={py(att(p.ai))} r="11" class="fill-a" style="opacity:0.18" />
      <circle cx={px(p.ai)} cy={py(att(p.ai))} r="6" class="fill-a" style="stroke: var(--surface); stroke-width: 2" />
      <text x={px(p.ai) + p.dx} y={py(att(p.ai)) + p.dy} class="t" font-size="11.5" font-weight="700" text-anchor={p.anchor}>{p.label}</text>
      <text x={px(p.ai) + p.dx} y={py(att(p.ai)) + p.dy + 15} class="t2 mono" font-size="10" text-anchor={p.anchor}>{p.sub}</text>
    </g>
  ))}
  <text x={(L + R) / 2} y={B + 36} class="t2" font-size="11" text-anchor="middle">arithmetic intensity, FLOPs per byte (log scale)</text>
  <text x="16" y={(T + B) / 2} class="t2" font-size="11" text-anchor="middle" transform={`rotate(-90 16 ${(T + B) / 2})`}>TFLOPS (log)</text>
</svg>
