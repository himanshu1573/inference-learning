---
// The CPU launches kernels one by one into a queue (a CUDA stream); the GPU runs them in order.
const kernels = ['norm', 'qkv', 'rope', 'attn', 'o', 'add'];
---
<svg viewBox="0 0 720 270" role="img" aria-label="The CPU puts kernel launches into a queue; the GPU takes them out one by one and runs each on all of its SMs">
  <defs>
    <marker id="kgl-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="fill-a" /></marker>
  </defs>
  <!-- CPU -->
  <rect x="16" y="40" width="160" height="150" rx="12" class="box" />
  <text x="96" y="66" class="t3 mono" font-size="11" text-anchor="middle">HOST</text>
  <text x="96" y="90" class="t" font-size="15" font-weight="700" text-anchor="middle">CPU</text>
  <text x="96" y="112" class="t2" font-size="11.5" text-anchor="middle">Python + PyTorch</text>
  <text x="96" y="128" class="t2" font-size="11.5" text-anchor="middle">decides what to run</text>
  <rect x="34" y="144" width="124" height="30" rx="7" class="amber" />
  <text x="96" y="164" class="tam mono" font-size="11" text-anchor="middle">≈ 5 µs per launch</text>

  <path d="M180 115 H206" class="line-a" stroke-width="1.6" marker-end="url(#kgl-arrow)" />

  <!-- queue -->
  <text x="364" y="34" class="t" font-size="13" font-weight="700" text-anchor="middle">Queue of launched kernels (a CUDA stream)</text>
  <rect x="210" y="70" width="310" height="90" rx="12" class="box2" />
  {kernels.map((k, i) => (
    <g>
      <rect x={470 - i * 50} y="92" width="44" height="46" rx="7" class={i === 0 ? 'box-a' : 'box'} />
      <text x={492 - i * 50} y="119" class={i === 0 ? 'ta mono' : 't2 mono'} font-size="10" text-anchor="middle">{k}</text>
    </g>
  ))}
  <text x="364" y="182" class="t3" font-size="11" text-anchor="middle">first in, first out: the GPU runs them in order</text>

  <path d="M524 115 H550" class="line-a" stroke-width="1.6" marker-end="url(#kgl-arrow)" />

  <!-- GPU -->
  <rect x="554" y="40" width="150" height="150" rx="12" class="box-a" />
  <text x="629" y="66" class="ta mono" font-size="11" text-anchor="middle">DEVICE</text>
  <text x="629" y="90" class="t" font-size="15" font-weight="700" text-anchor="middle">GPU</text>
  {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
    <rect x={572 + (i % 4) * 29} y={104 + Math.floor(i / 4) * 22} width="24" height="17" rx="3" class="box" />
  ))}
  <text x="629" y="166" class="t2" font-size="11" text-anchor="middle">one kernel at a time</text>
  <text x="629" y="180" class="t2" font-size="11" text-anchor="middle">on all 132 SMs</text>

  <text x="360" y="232" class="t2" font-size="12" text-anchor="middle">A kernel = one function that runs on the GPU. The CPU must <tspan class="ta" font-weight="700">launch</tspan> every kernel.</text>
  <text x="360" y="252" class="t3" font-size="11" text-anchor="middle">If the CPU launches more slowly than the GPU finishes, the GPU sits idle.</text>
</svg>
