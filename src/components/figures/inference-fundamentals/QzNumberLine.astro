---
// Our 8 example weights mapped to an asymmetric INT4 grid: scale 0.2539, zero point 5.
const scale = 0.2539;
const z = 5;
const vals = [0.431, -1.268, 0.087, 0.953, -0.314, 2.54, -0.662, 0.175];
const q = vals.map((v) => Math.min(15, Math.max(0, Math.round(v / scale) + z)));
const X0 = 60, X1 = 680;
const vmin = -1.4, vmax = 2.7;
const px = (v: number) => X0 + ((v - vmin) / (vmax - vmin)) * (X1 - X0);
---
<svg viewBox="0 0 720 260" role="img" aria-label="Eight real weights on a number line, each moved to the nearest of 16 INT4 levels. The levels are 0.254 apart and level 5 is the real value zero.">
  <text x="20" y="24" class="t" font-size="13" font-weight="700">Real values (top) snap to the nearest of 16 INT4 levels (bottom)</text>
  <!-- real line -->
  <text x="20" y="74" class="t3 mono" font-size="11">real</text>
  <path d={`M${X0} 70 H${X1}`} class="line-t" />
  {vals.map((v, i) => (
    <g>
      <circle cx={px(v)} cy="70" r="5" class="fill-a" />
      <path d={`M${px(v)} 76 L${px((q[i] - z) * scale)} 156`} class="line-a" stroke-dasharray="3 3" />
    </g>
  ))}
  {[-1, 0, 1, 2].map((t) => (
    <g>
      <path d={`M${px(t)} 64 V58`} class="line-t" />
      <text x={px(t)} y="52" class="t3 mono" font-size="10.5" text-anchor="middle">{t.toFixed(1)}</text>
    </g>
  ))}
  <!-- grid line -->
  <text x="20" y="166" class="t3 mono" font-size="11">INT4</text>
  <path d={`M${X0} 162 H${X1}`} class="line-t" />
  {Array.from({ length: 16 }, (_, k) => {
    const x = px((k - z) * scale);
    const used = q.includes(k);
    return (
      <g>
        <rect x={x - 8} y="152" width="16" height="20" rx="3" class={k === z ? 'green' : used ? 'box-a' : 'box'} />
        <text x={x} y="188" class={k === z ? 'tg mono' : 't2 mono'} font-size="10" text-anchor="middle">{k}</text>
      </g>
    );
  })}
  <text x={px(0)} y="208" class="tg" font-size="11" font-weight="600" text-anchor="middle">zero point = 5</text>
  <text x="20" y="240" class="t2" font-size="11.5">Levels are <tspan class="ta mono" font-weight="700">0.254</tspan> apart, so each value moves by at most half of that (≈ 0.127). That move is the quantization error.</text>
</svg>
