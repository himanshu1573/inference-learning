---
// One request: queue, prefill (TTFT), then 300 decode steps (TPOT). Not to scale.
const ticks = Array.from({ length: 22 }, (_, i) => 300 + i * 17);
---
<svg viewBox="0 0 720 230" role="img" aria-label="Timeline of one request with a 2000-token prompt and 300 output tokens: a short queue, prefill of about 65 milliseconds, then about 300 decode steps of about 5 milliseconds each, for a total of about 1.6 seconds">
  <defs>
    <marker id="pvdt-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="t3" /></marker>
  </defs>
  <text x="20" y="24" class="t" font-size="12.5" font-weight="700">One request: 2,000-token prompt, 300-token answer, batch 1, H100</text>

  <rect x="20" y="56" width="50" height="50" rx="8" class="box2" />
  <text x="45" y="85" class="t2" font-size="10.5" text-anchor="middle">queue</text>

  <rect x="76" y="56" width="216" height="50" rx="8" class="box-a" />
  <text x="184" y="78" class="t" font-size="12" font-weight="700" text-anchor="middle">prefill</text>
  <text x="184" y="95" class="t2 mono" font-size="10.5" text-anchor="middle">2,000 tokens · ≈ 65 ms</text>

  {ticks.map((x, i) => (
    <rect x={x} y="56" width="13" height="50" rx="3" class={i === 0 ? 'green' : 'box'} />
  ))}
  <text x="676" y="85" class="t3" font-size="16" text-anchor="middle">…</text>

  <path d="M20 128 H700" class="line-t" marker-end="url(#pvdt-arrow)" />
  <text x="700" y="146" class="t3 mono" font-size="10.5" text-anchor="end">time →</text>

  <path d="M20 158 V170 M300 158 V170 M20 164 H300" class="line-a" stroke-width="1.5" />
  <text x="160" y="188" class="ta" font-size="12" font-weight="700" text-anchor="middle">TTFT ≈ 65 ms (+ queue)</text>
  <text x="160" y="204" class="t3" font-size="10.5" text-anchor="middle">grows with prompt length</text>

  <path d="M317 158 V170 M334 158 V170 M317 164 H334" class="line-a" stroke-width="1.5" />
  <text x="340" y="188" class="ta" font-size="12" font-weight="700">TPOT ≈ 5 ms per token</text>
  <text x="340" y="204" class="t3" font-size="10.5">grows with model size and batch</text>
  <text x="700" y="188" class="t" font-size="12" font-weight="700" text-anchor="end">total ≈ 1.6 s</text>
  <text x="700" y="204" class="t3" font-size="10.5" text-anchor="end">not to scale</text>
</svg>
