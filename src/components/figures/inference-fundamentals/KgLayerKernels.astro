---
// Kernels in one transformer layer: simple PyTorch (about 30) vs fused, like vLLM (about 10).
const naive = [
  { n: 'RMSNorm', c: 6 }, { n: 'Q K V', c: 3 }, { n: 'RoPE', c: 6 }, { n: 'attention', c: 3 },
  { n: 'O', c: 1 }, { n: 'add', c: 1 }, { n: 'RMSNorm', c: 6 }, { n: 'gate up', c: 2 },
  { n: 'SiLU', c: 1 }, { n: 'mul', c: 1 }, { n: 'down', c: 1 }, { n: 'add', c: 1 },
];
const fused = ['add+norm', 'QKV', 'RoPE', 'KV write', 'attn', 'O', 'add+norm', 'gate_up', 'SiLU×mul', 'down'];
const w = 19.4;
let x = 20;
const naiveBoxes = naive.flatMap((g, gi) =>
  Array.from({ length: g.c }, (_, i) => {
    const box = { x, first: i === 0, label: g.n, gi, c: g.c };
    x += w;
    return box;
  }),
);
---
<svg viewBox="0 0 720 270" role="img" aria-label="One transformer layer needs about 30 small kernels in a simple PyTorch version, but only about 10 when operations are fused">
  <text x="20" y="28" class="t" font-size="13" font-weight="700">Simple PyTorch (eager): about 30 kernels per layer</text>
  {naiveBoxes.map((b) => (
    <rect x={b.x} y="42" width={w - 3} height="34" rx="4" class={b.gi % 2 ? 'box' : 'box2'} />
  ))}
  {naive.map((g, gi) => {
    const start = naiveBoxes.findIndex((b) => b.gi === gi);
    const cx = naiveBoxes[start].x + (g.c * w - 3) / 2;
    return <text x={cx} y={gi % 2 ? 106 : 92} class="t2" font-size="10" text-anchor="middle">{g.n}</text>;
  })}
  <text x="700" y="60" class="ta mono" font-size="13" font-weight="700" text-anchor="end">≈32</text>
  <text x="700" y="76" class="t3" font-size="10" text-anchor="end">kernels</text>

  <text x="20" y="152" class="t" font-size="13" font-weight="700">Fused (like vLLM): about 10 kernels per layer</text>
  {fused.map((f, i) => (
    <g>
      <rect x={20 + i * 62} y="166" width="56" height="40" rx="6" class={['QKV', 'O', 'gate_up', 'down'].includes(f) ? 'box' : 'box-a'} />
      <text x={48 + i * 62} y="190" class={['QKV', 'O', 'gate_up', 'down'].includes(f) ? 't2 mono' : 'ta mono'} font-size="9.5" text-anchor="middle">{f}</text>
    </g>
  ))}
  <text x="700" y="186" class="ta mono" font-size="13" font-weight="700" text-anchor="end">≈10</text>
  <text x="700" y="202" class="t3" font-size="10" text-anchor="end">kernels</text>

  <rect x="20" y="226" width="14" height="14" rx="3" class="box-a" />
  <text x="42" y="237" class="t2" font-size="11">fused kernel (several small steps in one)</text>
  <rect x="300" y="226" width="14" height="14" rx="3" class="box" />
  <text x="322" y="237" class="t2" font-size="11">matrix multiply (merged where possible: one QKV, one gate_up)</text>
  <text x="20" y="262" class="t3" font-size="11">Counts are approximate; they depend on the code version. Multiply by 32 layers for one decode step of Llama 3.1 8B.</text>
</svg>
