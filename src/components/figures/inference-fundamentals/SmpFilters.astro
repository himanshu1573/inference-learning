---
// top-k = 2, top-p = 0.9 and min-p = 0.1 on the same 4-token distribution.
const toks = ['pizza', 'pasta', 'sushi', 'rice'];
const p = [64.4, 23.7, 8.7, 3.2];
const panels = [
  { t: 'top-k = 2', s: 'keep the 2 most likely', keep: [true, true, false, false], extra: 'k' },
  { t: 'top-p = 0.9', s: 'keep until the sum reaches 90%', keep: [true, true, true, false], extra: 'p' },
  { t: 'min-p = 0.1', s: 'keep if ≥ 10% of the top chance', keep: [true, true, true, false], extra: 'm' },
];
const base = 200;
const H = 140;
const cum = [64.4, 88.1, 96.8, 100];
---
<svg viewBox="0 0 720 280" role="img" aria-label="Three filters on the same distribution. Top-k 2 keeps pizza and pasta. Top-p 0.9 keeps pizza, pasta and sushi because the sum passes 90 percent at sushi. Min-p 0.1 keeps tokens above 6.4 percent, which are pizza, pasta and sushi">
  {panels.map((pn, pi) => {
    const gx = 20 + pi * 236;
    return (
      <g>
        <text x={gx} y="22" class="t" font-size="12.5" font-weight="700">{pn.t}</text>
        <text x={gx} y="40" class="t3" font-size="10.5">{pn.s}</text>
        <line x1={gx} y1={base} x2={gx + 210} y2={base} class="line-t" />
        {p.map((v, i) => {
          const h = (v / 100) * H;
          const x = gx + 6 + i * 52;
          const k = pn.keep[i];
          return (
            <g>
              <rect x={x} y={base - h} width="40" height={h} rx="3" class={k ? 'fill-a' : 'box2'} style={k ? '' : 'stroke-dasharray: 3 3'} />
              <text x={x + 20} y={base - h - 6} class={k ? 'ta mono' : 't3 mono'} font-size="10.5" text-anchor="middle">{v}%</text>
              <text x={x + 20} y={base + 16} class={k ? 't2 mono' : 't3 mono'} font-size="10" text-anchor="middle" text-decoration={k ? '' : 'line-through'}>{toks[i]}</text>
              {pn.extra === 'p' && <text x={x + 20} y={base + 32} class="t3 mono" font-size="9.5" text-anchor="middle">Σ {cum[i]}</text>}
            </g>
          );
        })}
        {pn.extra === 'm' && (
          <g>
            <line x1={gx} y1={base - (6.44 / 100) * H} x2={gx + 210} y2={base - (6.44 / 100) * H} class="sr" stroke-dasharray="4 3" stroke-width="1.4" />
            <text x={gx + 105} y={base + 32} class="tr mono" font-size="9.5" text-anchor="middle">red line: 0.1 × 64.4% = 6.4%</text>
          </g>
        )}
      </g>
    );
  })}
  <text x="20" y="262" class="t2" font-size="11.5">Blue tokens stay; dashed ones are removed. The kept chances are then scaled up to add to 100% again.</text>
</svg>
