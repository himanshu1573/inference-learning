---
// Example timeline of one request. Top: zoom on the first ~80 ms. Bottom: the whole request.
const zoom = [
  { label: 'network in', ms: 20, cls: 'box2' },
  { label: 'API + template', ms: 2, cls: 'box2' },
  { label: 'tokenize', ms: 1, cls: 'box2' },
  { label: 'queue', ms: 0, cls: 'amber' },
  { label: 'prefill', ms: 30, cls: 'box-a' },
  { label: 'network out', ms: 20, cls: 'box2' },
];
const scale = 6.2; // px per ms in the zoom view
let acc = 0;
const zoomBars = zoom.map((z) => {
  const start = acc;
  acc += z.ms;
  return { ...z, x: 40 + start * scale, w: Math.max(z.ms * scale, 2) };
});
const ttft = acc; // 73 ms
// full view: 0 .. 2,500 ms
const fx = (ms: number) => 40 + (ms / 2500) * 640;
---
<svg viewBox="0 0 720 330" role="img" aria-label="Example timeline: about 73 ms until the first token, then about 2.4 seconds of decode for 399 more tokens">
  <text x="40" y="22" class="t" font-size="13" font-weight="700">Zoom: the first {ttft} ms (until the first token appears)</text>
  {zoomBars.map((b, i) => (
    <g>
      <rect x={b.x} y={40 + i * 20} width={b.w} height="16" rx="3" class={b.cls} />
      <text x={b.x + b.w + 6} y={52 + i * 20} class="t2" font-size="10.5">{b.label} <tspan class="ta mono" font-weight="600">{b.ms} ms</tspan></text>
    </g>
  ))}
  <path d={`M40 168 H${40 + ttft * scale}`} class="line-a" stroke-width="1.5" />
  <path d={`M40 162 V174 M${40 + ttft * scale} 162 V174`} class="line-a" stroke-width="1.5" />
  <text x={40 + (ttft * scale) / 2} y="188" class="ta" font-size="11.5" font-weight="700" text-anchor="middle">TTFT ≈ {ttft} ms</text>
  <text x="704" y="56" class="t3" font-size="10.5" text-anchor="end">queue = 0 ms on an idle server;</text>
  <text x="704" y="70" class="t3" font-size="10.5" text-anchor="end">on a busy server it can be seconds</text>

  <!-- full view -->
  <text x="40" y="224" class="t" font-size="13" font-weight="700">The whole request (400 output tokens)</text>
  <rect x={fx(0)} y="240" width={fx(ttft) - fx(0)} height="26" rx="3" class="box-a" />
  <rect x={fx(ttft)} y="240" width={fx(ttft + 399 * 6) - fx(ttft)} height="26" rx="3" class="green" />
  {Array.from({ length: 40 }, (_, i) => <path d={`M${fx(ttft + i * 60)} 240 V266`} class="sg" stroke-width="0.6" opacity="0.5" />)}
  <text x={fx(ttft) + 10} y="258" class="tg" font-size="11" font-weight="600">decode: 399 more tokens × about 6 ms each ≈ 2.4 s</text>
  <path d="M40 286 H680" class="line-t" />
  {[0, 500, 1000, 1500, 2000, 2500].map((ms) => (
    <g>
      <path d={`M${fx(ms)} 282 V290`} class="line-t" />
      <text x={fx(ms)} y="304" class="t3 mono" font-size="10" text-anchor="middle">{ms / 1000} s</text>
    </g>
  ))}
  <text x="40" y="324" class="t3" font-size="10.5">The first token is the tiny blue sliver at the start. Almost all of the time is decode.</text>
</svg>
