---
// Same logits (3, 2, 1, 0) at three temperatures.
const toks = ['pizza', 'pasta', 'sushi', 'rice'];
const groups = [
  { T: '0.5', p: [86.5, 11.7, 1.6, 0.2], note: 'sharper' },
  { T: '1.0', p: [64.4, 23.7, 8.7, 3.2], note: 'unchanged' },
  { T: '2.0', p: [45.5, 27.6, 16.7, 10.2], note: 'flatter' },
];
const base = 210;
const H = 150;
---
<svg viewBox="0 0 720 270" role="img" aria-label="Probabilities of pizza, pasta, sushi and rice at temperature 0.5, 1 and 2. Low temperature makes the top token stronger; high temperature makes the chances more equal">
  {groups.map((g, gi) => {
    const gx = 20 + gi * 236;
    return (
      <g>
        <text x={gx} y="22" class="t" font-size="12.5" font-weight="700">T = {g.T}</text>
        <text x={gx + 70} y="22" class="t3" font-size="11">{g.note}</text>
        <line x1={gx} y1={base} x2={gx + 210} y2={base} class="line-t" />
        {g.p.map((p, i) => {
          const h = (p / 100) * H;
          const x = gx + 6 + i * 52;
          return (
            <g>
              <rect x={x} y={base - h} width="40" height={Math.max(h, 1.5)} rx="3" class={i === 0 ? 'fill-a' : 'fill-soft'} style={i === 0 ? '' : 'stroke: var(--accent)'} />
              <text x={x + 20} y={base - h - 6} class={i === 0 ? 'ta mono' : 't2 mono'} font-size="10.5" font-weight={i === 0 ? '700' : '400'} text-anchor="middle">{p}%</text>
              <text x={x + 20} y={base + 16} class="t2 mono" font-size="10" text-anchor="middle">{toks[i]}</text>
            </g>
          );
        })}
      </g>
    );
  })}
  <text x="20" y="256" class="t3" font-size="11">Logits are 3, 2, 1 and 0 in all three groups. Only the temperature changes.</text>
</svg>
