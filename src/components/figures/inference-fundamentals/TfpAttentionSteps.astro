---
// Tiny attention example: 3 tokens, 2 numbers per vector. Mask, scores, softmax, weighted sum.
const toks = ['I', 'like', 'cats'];
---
<svg viewBox="0 0 720 300" role="img" aria-label="Attention worked example: a causal mask lets each token see only itself and earlier tokens; for the token cats the scores 1, 1, 2 become weights 0.25, 0.25, 0.50, and the output is 0.25 v1 + 0.25 v2 + 0.50 v3 = [1.76, 1.00]">
  <!-- panel 1: mask -->
  <text x="20" y="26" class="t" font-size="13" font-weight="700">1 · Who can see whom</text>
  <text x="20" y="44" class="t3" font-size="11">causal mask (row = the token that looks)</text>
  {toks.map((t, c) => (
    <text x={92 + c * 46} y="70" class="t2 mono" font-size="10.5" text-anchor="middle">{t}</text>
  ))}
  {toks.map((t, r) => (
    <g>
      <text x="62" y={100 + r * 46} class="t2 mono" font-size="10.5" text-anchor="end">{t}</text>
      {toks.map((_, c) => (
        <g>
          <rect x={70 + c * 46} y={80 + r * 46} width="42" height="40" rx="6" class={c <= r ? 'box-a' : 'box2'} />
          <text x={91 + c * 46} y={105 + r * 46} class={c <= r ? 'ta' : 't3'} font-size="13" font-weight="700" text-anchor="middle">{c <= r ? '✓' : '−∞'}</text>
        </g>
      ))}
    </g>
  ))}
  <text x="20" y="242" class="t2" font-size="11">“cats” may look at all 3 tokens.</text>
  <text x="20" y="258" class="t2" font-size="11">“I” may only look at itself.</text>
  <text x="20" y="274" class="t3" font-size="10.5">−∞ becomes 0 after softmax.</text>

  <!-- panel 2: scores for cats -->
  <line x1="232" y1="16" x2="232" y2="284" class="line" stroke-dasharray="3 4" />
  <text x="250" y="26" class="t" font-size="13" font-weight="700">2 · Scores for “cats”</text>
  <text x="250" y="44" class="t3 mono" font-size="10.5">q₃ = [1, 1]</text>
  {[
    { k: 'k₁ = [1, 0]', s: '1', d: '0.71', w: '0.25' },
    { k: 'k₂ = [0, 1]', s: '1', d: '0.71', w: '0.25' },
    { k: 'k₃ = [1, 1]', s: '2', d: '1.41', w: '0.50' },
  ].map((r, i) => (
    <g>
      <text x="250" y={96 + i * 44} class="t2 mono" font-size="11">{r.k}</text>
      <text x="356" y={96 + i * 44} class="t mono" font-size="12" text-anchor="middle">{r.s}</text>
      <text x="410" y={96 + i * 44} class="t mono" font-size="12" text-anchor="middle">{r.d}</text>
      <rect x="436" y={80 + i * 44} width="40" height="24" rx="5" class="box-a" />
      <text x="456" y={96 + i * 44} class="ta mono" font-size="12" font-weight="700" text-anchor="middle">{r.w}</text>
    </g>
  ))}
  <text x="356" y="70" class="t3 mono" font-size="10" text-anchor="middle">q·k</text>
  <text x="410" y="70" class="t3 mono" font-size="10" text-anchor="middle">÷ √2</text>
  <text x="456" y="70" class="t3 mono" font-size="10" text-anchor="middle">softmax</text>
  <text x="250" y="242" class="t2" font-size="11">k₃ points the same way as q₃,</text>
  <text x="250" y="258" class="t2" font-size="11">so it gets the biggest weight.</text>
  <text x="250" y="274" class="t3" font-size="10.5">The weights add up to 1.</text>

  <!-- panel 3: weighted sum -->
  <line x1="494" y1="16" x2="494" y2="284" class="line" stroke-dasharray="3 4" />
  <text x="512" y="26" class="t" font-size="13" font-weight="700">3 · Mix the values</text>
  <text x="512" y="44" class="t3" font-size="11">output = Σ weight × v</text>
  <text x="512" y="96" class="t2 mono" font-size="11.5">0.25 × v₁ [1, 0]</text>
  <text x="512" y="122" class="t2 mono" font-size="11.5">0.25 × v₂ [0, 2]</text>
  <text x="512" y="148" class="t2 mono" font-size="11.5">0.50 × v₃ [3, 1]</text>
  <line x1="512" y1="162" x2="700" y2="162" class="line-t" />
  <rect x="512" y="174" width="188" height="34" rx="8" class="box-a" />
  <text x="606" y="196" class="ta mono" font-size="13" font-weight="700" text-anchor="middle">= [1.76, 1.00]</text>
  <text x="512" y="242" class="t2" font-size="11">The new vector for “cats” now</text>
  <text x="512" y="258" class="t2" font-size="11">carries information from the</text>
  <text x="512" y="274" class="t2" font-size="11">tokens it paid attention to.</text>
</svg>
