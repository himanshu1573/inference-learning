---
// Without a cache every step recomputes K and V for all tokens; with a cache only the new token.
const steps = [1, 2, 3, 4, 5];
const cols = 7;
const prompt = 3;
const cw = 30, gap = 4;
function cellState(step: number, col: number, cached: boolean) {
  const len = prompt + step - 1; // tokens processed at this step
  if (col > len) return 'empty';
  if (!cached) return 'compute';
  if (step === 1) return 'compute';
  return col === len ? 'compute' : 'cache';
}
const panels = [
  { x: 20, cached: false, title: 'Without a KV cache', total: '3 + 4 + 5 + 6 + 7 = 25' },
  { x: 380, cached: true, title: 'With a KV cache', total: '3 + 1 + 1 + 1 + 1 = 7' },
];
---
<svg viewBox="0 0 720 330" role="img" aria-label="Two grids. Without a KV cache every step recomputes keys and values for all tokens, 25 token computations in 5 steps. With a cache each step only computes the new token, 7 computations.">
  {panels.map((p) => (
    <g>
      <text x={p.x} y="24" class="t" font-size="14" font-weight="700">{p.title}</text>
      <text x={p.x} y="42" class="t3" font-size="11">rows = steps, columns = token positions</text>
      {Array.from({ length: cols }, (_, c) => (
        <text x={p.x + 70 + c * (cw + gap) + cw / 2} y="64" class="t3 mono" font-size="10" text-anchor="middle">{c + 1}</text>
      ))}
      {steps.map((s) => (
        <g>
          <text x={p.x + 56} y={88 + (s - 1) * 38} class="t2 mono" font-size="10.5" text-anchor="end">step {s}</text>
          {Array.from({ length: cols }, (_, c) => {
            const st = cellState(s, c + 1, p.cached);
            const cls = st === 'compute' ? 'box-a' : st === 'cache' ? 'green' : 'box';
            return <rect x={p.x + 70 + c * (cw + gap)} y={70 + (s - 1) * 38} width={cw} height={28} rx="5" class={cls} style={st === 'empty' ? 'opacity:0.35' : ''} />;
          })}
        </g>
      ))}
      <text x={p.x} y="276" class="t2" font-size="11.5">token computations:</text>
      <text x={p.x} y="296" class="ta mono" font-size="13" font-weight="700">{p.total}</text>
    </g>
  ))}
  <g>
    <rect x="200" y="308" width="14" height="14" rx="3" class="box-a" />
    <text x="220" y="319" class="t2" font-size="11">compute K and V</text>
    <rect x="340" y="308" width="14" height="14" rx="3" class="green" />
    <text x="360" y="319" class="t2" font-size="11">read from cache</text>
    <rect x="480" y="308" width="14" height="14" rx="3" class="box" style="opacity:0.35" />
    <text x="500" y="319" class="t2" font-size="11">not yet written</text>
  </g>
</svg>
