---
// 10 requests sorted by TTFT. Mean vs p50 / p90 / p99 (nearest-rank method).
const ttft = [180, 190, 200, 210, 220, 230, 240, 260, 900, 2400];
const mean = ttft.reduce((a, b) => a + b, 0) / ttft.length; // 503
const X0 = 70, X1 = 520, Y0 = 30, Y1 = 230, MAX = 2500;
const bw = (X1 - X0) / ttft.length;
const yOf = (v: number) => Y1 - (v / MAX) * (Y1 - Y0);
const lines = [
  { v: 225, name: 'p50 (median)', cls: 'line-a', tcls: 'ta' },
  { v: mean, name: 'mean (average)', cls: 'sam', tcls: 'tam' },
  { v: 900, name: 'p90', cls: 'sr', tcls: 'tr' },
  { v: 2400, name: 'p99', cls: 'line-t', tcls: 't' },
];
---
<svg viewBox="0 0 720 270" role="img" aria-label="Ten requests sorted by time to first token. Eight are between 180 and 260 milliseconds, one is 900 and one is 2,400. The median is 225 milliseconds, the mean is 503, p90 is 900 and p99 is 2,400.">
  {[0, 500, 1000, 1500, 2000, 2500].map((v) => (
    <g>
      <line x1={X0} y1={yOf(v)} x2={X1} y2={yOf(v)} class="line" stroke-dasharray={v === 0 ? '' : '2 4'} />
      <text x={X0 - 8} y={yOf(v) + 4} class="t3 mono" font-size="10.5" text-anchor="end">{v}</text>
    </g>
  ))}
  <text x="12" y="20" class="t2" font-size="11.5">TTFT (ms)</text>
  {ttft.map((t, i) => (
    <g>
      <rect x={X0 + i * bw + 7} y={yOf(t)} width={bw - 14} height={Y1 - yOf(t)} rx="3" class={t > 500 ? 'red' : 'box-a'} />
      <text x={X0 + i * bw + bw / 2} y={Y1 + 16} class="t3 mono" font-size="10.5" text-anchor="middle">{i + 1}</text>
    </g>
  ))}
  <text x={(X0 + X1) / 2} y={Y1 + 34} class="t2" font-size="11.5" text-anchor="middle">requests, sorted from fastest to slowest</text>
  {lines.map((l) => (
    <line x1={X0} y1={yOf(l.v)} x2={X1 + 14} y2={yOf(l.v)} class={l.cls} stroke-width="1.8" stroke-dasharray="6 4" />
  ))}
  <!-- right-hand labels, spaced so they never overlap -->
  {[
    { l: lines[3], y: yOf(2400) + 4 },
    { l: lines[2], y: yOf(900) + 4 },
    { l: lines[1], y: yOf(mean) - 2 },
    { l: lines[0], y: yOf(225) + 14 },
  ].map(({ l, y }) => (
    <g>
      <text x={X1 + 22} y={y} class={l.tcls} font-size="12" font-weight="700">{l.name}</text>
      <text x={X1 + 186} y={y} class={l.tcls + ' mono'} font-size="12" font-weight="700" text-anchor="end">{Math.round(l.v).toLocaleString('en-US')} ms</text>
    </g>
  ))}
</svg>
