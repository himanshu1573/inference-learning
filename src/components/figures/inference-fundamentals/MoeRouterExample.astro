---
// Worked routing example: x -> 4 router scores -> softmax -> top-2 -> renormalised weights.
const x = ['1', '0', '2', '−1'];
const logits = [2.0, 0.5, 1.0, -1.0];
const exps = logits.map((l) => Math.exp(l));
const sum = exps.reduce((a, b) => a + b, 0);
const probs = exps.map((e) => e / sum);
const top = [0, 2];
const topSum = probs[0] + probs[2];
const y0 = 96;
const dy = 38;
---
<svg viewBox="0 0 720 300" role="img" aria-label="Router example: the token vector gives scores 2.0, 0.5, 1.0 and minus 1.0 for four experts. Softmax turns them into 61, 14, 22 and 3 percent. The top two, experts 1 and 3, are kept and renormalised to 73 and 27 percent.">
  <defs>
    <marker id="mre-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="fill-a" /></marker>
  </defs>
  <!-- column headers -->
  <text x="62" y="28" class="t" font-size="12.5" font-weight="700" text-anchor="middle">Token vector x</text>
  <text x="62" y="44" class="t3" font-size="10.5" text-anchor="middle">4 numbers (tiny example)</text>
  <text x="235" y="28" class="t" font-size="12.5" font-weight="700" text-anchor="middle">1 · Router scores</text>
  <text x="235" y="44" class="t3" font-size="10.5" text-anchor="middle">one dot product per expert</text>
  <text x="420" y="28" class="t" font-size="12.5" font-weight="700" text-anchor="middle">2 · Softmax</text>
  <text x="420" y="44" class="t3" font-size="10.5" text-anchor="middle">scores → probabilities</text>
  <text x="608" y="28" class="t" font-size="12.5" font-weight="700" text-anchor="middle">3 · Keep top-2</text>
  <text x="608" y="44" class="t3" font-size="10.5" text-anchor="middle">renormalise to 100%</text>

  <!-- x vector -->
  <rect x="32" y={y0 - 26} width="60" height={dy * 4 + 4} rx="8" class="box" />
  {x.map((v, i) => (
    <text x="62" y={y0 + i * dy} class="ta mono" font-size="14" font-weight="600" text-anchor="middle">{v}</text>
  ))}
  <path d="M100 152 H128" class="line-a" stroke-width="1.5" marker-end="url(#mre-a)" />

  {logits.map((l, i) => {
    const y = y0 + i * dy;
    const isTop = top.includes(i);
    return (
      <g>
        <!-- scores -->
        <text x="148" y={y} class="t2 mono" font-size="11.5">E{i + 1}</text>
        <line x1="230" y1={y - 16} x2="230" y2={y + 6} class="line" />
        {l >= 0 ? (
          <rect x="230" y={y - 12} width={l * 30} height="14" rx="3" class={isTop ? 'fill-a' : 'fill-soft'} style={isTop ? '' : 'stroke: var(--accent)'} />
        ) : (
          <rect x={230 + l * 30} y={y - 12} width={-l * 30} height="14" rx="3" class="red" />
        )}
        <text x={l >= 0 ? 236 + l * 30 : 236} y={y} class="t mono" font-size="11.5" font-weight="600">{l.toFixed(1)}</text>

        <!-- softmax -->
        <rect x="370" y={y - 12} width="100" height="14" rx="3" class="fill-soft" />
        <rect x="370" y={y - 12} width={Math.max(2, probs[i] * 100)} height="14" rx="3" class={isTop ? 'fill-a' : 'line-t'} style={isTop ? '' : 'fill: var(--text-3)'} />
        <text x="478" y={y} class={isTop ? 't mono' : 't3 mono'} font-size="11.5" font-weight="600">{Math.round(probs[i] * 100)}%</text>

        <!-- top-2 -->
        {isTop ? (
          <g>
            <rect x="548" y={y - 18} width="122" height="26" rx="6" class="box-a" />
            <text x="560" y={y} class="ta mono" font-size="11.5" font-weight="700">E{i + 1}</text>
            <text x="658" y={y} class="ta mono" font-size="12" font-weight="700" text-anchor="end">{Math.round((probs[i] / topSum) * 100)}%</text>
          </g>
        ) : (
          <text x="560" y={y} class="t3 mono" font-size="11.5" text-decoration="line-through">E{i + 1}  not used</text>
        )}
      </g>
    );
  })}
  <path d="M520 152 H540" class="line-a" stroke-width="1.5" marker-end="url(#mre-a)" />
  <path d="M325 152 H360" class="line-a" stroke-width="1.5" marker-end="url(#mre-a)" />

  <rect x="120" y="252" width="480" height="34" rx="8" class="box2" />
  <text x="360" y="274" class="t mono" font-size="13" font-weight="600" text-anchor="middle">output = 0.73 × E1(x) + 0.27 × E3(x)</text>
</svg>
