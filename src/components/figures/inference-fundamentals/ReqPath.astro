---
// The full path of one chat request, out and back.
const top = [
  { x: 16, n: '1', t: 'Client', s: ['your app sends', 'an HTTP request'], tag: 'network' },
  { x: 156, n: '2', t: 'API server', s: ['checks the request,', 'applies chat template'], tag: 'CPU' },
  { x: 296, n: '3', t: 'Tokenizer', s: ['text → token IDs'], tag: 'CPU' },
  { x: 436, n: '4', t: 'Scheduler queue', s: ['waits for a free', 'slot on the GPU'], tag: 'CPU' },
  { x: 576, n: '5', t: 'GPU: prefill', s: ['reads the whole', 'prompt at once'], tag: 'GPU', hi: true },
];
const bottom = [
  { x: 16, n: '9', t: 'Screen', s: ['words appear', 'one by one'], tag: 'network' },
  { x: 156, n: '8', t: 'Stream (SSE)', s: ['send each piece', 'right away'], tag: 'CPU' },
  { x: 296, n: '7', t: 'Detokenizer', s: ['token IDs → text'], tag: 'CPU' },
  { x: 436, n: '6', t: 'GPU: decode loop', s: ['one new token', 'per step'], tag: 'GPU', hi: true, wide: true },
];
const W = 128;
---
<svg viewBox="0 0 720 330" role="img" aria-label="The path of a chat request: client, API server, tokenizer, scheduler queue, GPU prefill, GPU decode loop, detokenizer, streaming, screen">
  <defs>
    <marker id="rp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="fill-a" /></marker>
  </defs>
  <text x="16" y="20" class="t3 mono" font-size="10.5">GOING IN →</text>
  {top.map((b, i) => (
    <g>
      <rect x={b.x} y="30" width={W} height="96" rx="11" class={b.hi ? 'box-a' : 'box'} />
      <circle cx={b.x + 18} cy="50" r="10" class="box2" />
      <text x={b.x + 18} y="54" class="ta mono" font-size="10.5" font-weight="700" text-anchor="middle">{b.n}</text>
      <text x={b.x + W - 10} y="54" class="t3 mono" font-size="9.5" text-anchor="end">{b.tag}</text>
      <text x={b.x + 12} y="80" class="t" font-size="13" font-weight="700">{b.t}</text>
      {b.s.map((line, j) => <text x={b.x + 12} y={98 + j * 14} class="t2" font-size="10.5">{line}</text>)}
      {i < top.length - 1 && <path d={`M${b.x + W + 2} 78 H${b.x + 138}`} class="line-a" stroke-width="1.6" marker-end="url(#rp-arrow)" />}
    </g>
  ))}
  <!-- prefill down to decode -->
  <path d="M640 130 V170 H640 V196" class="line-a" stroke-width="1.6" marker-end="url(#rp-arrow)" />
  <text x="650" y="168" class="ta" font-size="10.5" font-weight="600">first token</text>

  <text x="16" y="318" class="t3 mono" font-size="10.5">← COMING BACK</text>
  {bottom.map((b, i) => {
    const w = b.wide ? 268 : W;
    return (
      <g>
        <rect x={b.x} y="200" width={w} height="96" rx="11" class={b.hi ? 'box-a' : 'box'} />
        <circle cx={b.x + 18} cy="220" r="10" class="box2" />
        <text x={b.x + 18} y="224" class="ta mono" font-size="10.5" font-weight="700" text-anchor="middle">{b.n}</text>
        <text x={b.x + w - 10} y="224" class="t3 mono" font-size="9.5" text-anchor="end">{b.tag}</text>
        <text x={b.x + 12} y="250" class="t" font-size="13" font-weight="700">{b.t}</text>
        {b.s.map((line, j) => <text x={b.x + 12} y={268 + j * 14} class="t2" font-size="10.5">{line}</text>)}
        {i > 0 && <path d={`M${b.x - 2} 248 H${b.x - 10}`} class="line-a" stroke-width="1.6" marker-end="url(#rp-arrow)" />}
      </g>
    );
  })}
  <!-- decode loop arrow -->
  <path d="M600 250 a22 22 0 1 0 44 0 a22 22 0 1 0 -44 0" class="line-a" stroke-width="1.4" stroke-dasharray="4 3" />
  <text x="622" y="254" class="ta mono" font-size="10" font-weight="700" text-anchor="middle">×400</text>
</svg>
