---
// 16 tokens × top-2 = 32 expert slots over 8 experts. Balanced vs unbalanced.
const balanced = [4, 4, 4, 4, 4, 4, 4, 4];
const unbalanced = [9, 6, 4, 3, 3, 3, 2, 2];
const panels = [
  { x: 20, title: 'Balanced routing', sub: 'every expert gets 16 × 2 ÷ 8 = 4 tokens', counts: balanced },
  { x: 380, title: 'Unbalanced routing', sub: 'one busy expert gets 9 tokens', counts: unbalanced },
];
const base = 214;
const cell = 15;
---
<svg viewBox="0 0 720 286" role="img" aria-label="Two panels with 8 experts each. Left: balanced routing, each expert gets 4 tokens. Right: unbalanced routing, expert 1 gets 9 tokens and others get 2 to 6, so the busiest expert sets the time for the whole step.">
  {panels.map((p, pi) => {
    const max = Math.max(...p.counts);
    return (
      <g>
        <text x={p.x + 160} y="24" class="t" font-size="13" font-weight="700" text-anchor="middle">{p.title}</text>
        <text x={p.x + 160} y="41" class="t3" font-size="11" text-anchor="middle">{p.sub}</text>
        <line x1={p.x} y1={base + 2} x2={p.x + 320} y2={base + 2} class="line" />
        {p.counts.map((c, i) => {
          const x = p.x + 8 + i * 39;
          const hot = pi === 1 && c === max;
          return (
            <g>
              {Array.from({ length: c }).map((_, j) => (
                <rect x={x} y={base - (j + 1) * cell} width="30" height={cell - 3} rx="3" class={hot ? 'red' : 'box-a'} />
              ))}
              <text x={x + 15} y={base - c * cell - 6} class={hot ? 'tr mono' : 't2 mono'} font-size="11" font-weight="600" text-anchor="middle">{c}</text>
              <text x={x + 15} y={base + 18} class="t3 mono" font-size="10.5" text-anchor="middle">E{i + 1}</text>
            </g>
          );
        })}
        {pi === 0 ? (
          <text x={p.x + 160} y="262" class="tg" font-size="11.5" font-weight="600" text-anchor="middle">all experts finish at the same time</text>
        ) : (
          <g>
            <line x1={p.x + 4} y1={base - max * cell} x2={p.x + 320} y2={base - max * cell} class="sr" stroke-dasharray="4 4" />
            <text x={p.x + 160} y="262" class="tr" font-size="11.5" font-weight="600" text-anchor="middle">the step waits for E1 (9 tokens of work)</text>
          </g>
        )}
      </g>
    );
  })}
  <line x1="360" y1="20" x2="360" y2="270" class="line" stroke-dasharray="3 5" />
  <text x="360" y="282" class="t3" font-size="10.5" text-anchor="middle">Each small box = one token sent to that expert. Both panels hold the same 32 boxes.</text>
</svg>
