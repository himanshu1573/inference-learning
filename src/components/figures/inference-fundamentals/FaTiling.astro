---
// FlashAttention tiling: one Q block walks over all K/V blocks; tiles of S live only on the chip.
const n = 8, c = 30, x0 = 60, y0 = 70, row = 3, cur = 4;
function tileStyle(i: number, j: number) {
  if (i !== row) return { cls: 'box', st: 'opacity:0.45' };
  if (j < cur) return { cls: 'green', st: '' };
  if (j === cur) return { cls: 'box-a', st: 'stroke-width:2' };
  return { cls: 'box', st: '' };
}
---
<svg viewBox="0 0 720 360" role="img" aria-label="The score matrix split into 8 by 8 tiles. One block of queries moves across all key-value blocks, one tile at a time. Each tile is computed in on-chip memory, used to update a running maximum, running sum and output, and then thrown away.">
  <defs>
    <marker id="fat-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="fill-a" /></marker>
  </defs>
  <text x={x0} y="24" class="t" font-size="13" font-weight="700">The N × N score matrix, cut into tiles</text>
  <text x={x0} y="42" class="t3" font-size="11">it is never stored as a whole</text>
  <text x={x0 + (n * c) / 2} y="62" class="t3 mono" font-size="10" text-anchor="middle">K, V blocks j = 1 … 8 →</text>
  {Array.from({ length: n }, (_, i) =>
    Array.from({ length: n }, (_, j) => {
      const { cls, st } = tileStyle(i, j);
      return <rect x={x0 + j * c} y={y0 + i * c} width={c - 3} height={c - 3} rx="3" class={cls} style={st} />;
    }),
  )}
  <text x={x0 - 8} y={y0 + row * c + 19} class="ta mono" font-size="10.5" font-weight="700" text-anchor="end">Qᵢ</text>
  <text x={x0 - 8} y={y0 + 12} class="t3 mono" font-size="9.5" text-anchor="end">Q₁</text>
  <text x={x0 + n * c / 2} y={y0 + n * c + 22} class="t2" font-size="11" text-anchor="middle">green = done · blue = now · grey = next</text>

  <path d={`M${x0 + cur * c + c / 2} ${y0 + row * c + 14} C 380 ${y0 + row * c + 14}, 380 130, 420 130`} class="line-a" stroke-width="1.5" marker-end="url(#fat-arrow)" />

  <!-- SRAM box -->
  <rect x="424" y="62" width="280" height="260" rx="12" class="box-a" style="fill-opacity:0.35" />
  <text x="440" y="84" class="ta mono" font-size="10.5" font-weight="700">ON-CHIP MEMORY OF ONE SM</text>
  <rect x="440" y="96" width="76" height="40" rx="6" class="box" /><text x="478" y="114" class="t mono" font-size="11" font-weight="700" text-anchor="middle">Qᵢ</text><text x="478" y="129" class="t3" font-size="9.5" text-anchor="middle">stays</text>
  <rect x="526" y="96" width="76" height="40" rx="6" class="green" /><text x="564" y="114" class="t mono" font-size="11" font-weight="700" text-anchor="middle">Kⱼ</text><text x="564" y="129" class="t3" font-size="9.5" text-anchor="middle">streams in</text>
  <rect x="612" y="96" width="76" height="40" rx="6" class="amber" /><text x="650" y="114" class="t mono" font-size="11" font-weight="700" text-anchor="middle">Vⱼ</text><text x="650" y="129" class="t3" font-size="9.5" text-anchor="middle">streams in</text>
  <rect x="440" y="148" width="248" height="40" rx="6" class="box" />
  <text x="564" y="166" class="t" font-size="11.5" font-weight="700" text-anchor="middle">Sᵢⱼ = Qᵢ · Kⱼᵀ  (one tile)</text>
  <text x="564" y="181" class="t3" font-size="9.5" text-anchor="middle">used, then thrown away</text>
  <rect x="440" y="200" width="118" height="44" rx="6" class="violet" />
  <text x="499" y="219" class="t mono" font-size="11" font-weight="700" text-anchor="middle">m, ℓ</text>
  <text x="499" y="235" class="t3" font-size="9.5" text-anchor="middle">running max, sum</text>
  <rect x="570" y="200" width="118" height="44" rx="6" class="violet" />
  <text x="629" y="219" class="t mono" font-size="11" font-weight="700" text-anchor="middle">Oᵢ</text>
  <text x="629" y="235" class="t3" font-size="9.5" text-anchor="middle">running output</text>
  <text x="440" y="270" class="t2" font-size="11">After the last K, V block:</text>
  <text x="440" y="288" class="t" font-size="11.5" font-weight="700">write Oᵢ ÷ ℓ to HBM, once.</text>
  <text x="440" y="308" class="t3" font-size="10.5">No N × N matrix ever goes to HBM.</text>
</svg>
