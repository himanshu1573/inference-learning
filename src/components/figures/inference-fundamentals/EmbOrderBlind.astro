---
// Without positions, two sentences with the same words look the same.
const a = ['dog', 'bites', 'man'];
const b = ['man', 'bites', 'dog'];
---
<svg viewBox="0 0 720 220" role="img" aria-label="Dog bites man and man bites dog contain the same three vectors; without position information they look identical">
  {[a, b].map((s, k) => (
    <g>
      <text x="16" y={34 + k * 92} class="t" font-size="13" font-weight="700">“{s.join(' ')}”</text>
      {s.map((w, i) => (
        <g>
          <rect x={16 + i * 96} y={46 + k * 92} width="86" height="34" rx="7" class={w === 'dog' ? 'green' : w === 'man' ? 'amber' : 'box'} />
          <text x={59 + i * 96} y={68 + k * 92} class="t mono" font-size="12" text-anchor="middle">{w}</text>
        </g>
      ))}
    </g>
  ))}
  <rect x="340" y="46" width="364" height="126" rx="10" class="box2" />
  <text x="356" y="72" class="t" font-size="12.5" font-weight="700">What the model has without positions</text>
  {['dog', 'bites', 'man'].map((w, i) => (
    <g>
      <rect x={356 + i * 110} y="88" width="96" height="34" rx="7" class={w === 'dog' ? 'green' : w === 'man' ? 'amber' : 'box'} />
      <text x={404 + i * 110} y="110" class="t mono" font-size="12" text-anchor="middle">{w}</text>
    </g>
  ))}
  <text x="356" y="148" class="t2" font-size="11">The same three vectors in both sentences.</text>
  <text x="356" y="163" class="t2" font-size="11">Attention alone cannot tell who bit whom.</text>
  <text x="16" y="206" class="ta" font-size="11.5" font-weight="600">So the model must also be told where each token is: position information.</text>
</svg>
