---
// Each gap between tokens of one request (ITL) vs the average (TPOT).
const gaps = [20, 21, 19, 20, 22, 20, 19, 21, 20, 118, 22, 20, 19, 21, 20, 20, 23, 19, 20, 21, 20, 19, 22, 20];
const mean = gaps.reduce((a, b) => a + b, 0) / gaps.length;
const X0 = 70, X1 = 690, Y0 = 40, Y1 = 220, MAX = 130;
const bw = (X1 - X0) / gaps.length;
const yOf = (v: number) => Y1 - (v / MAX) * (Y1 - Y0);
---
<svg viewBox="0 0 720 270" role="img" aria-label={`Bar chart of 24 gaps between tokens. Most gaps are about 20 milliseconds, but one gap is 118 milliseconds because another request's prefill ran in that step. The average, TPOT, is about ${mean.toFixed(1)} milliseconds.`}>
  {[0, 25, 50, 75, 100, 125].map((v) => (
    <g>
      <line x1={X0} y1={yOf(v)} x2={X1} y2={yOf(v)} class="line" stroke-dasharray={v === 0 ? '' : '2 4'} />
      <text x={X0 - 8} y={yOf(v) + 4} class="t3 mono" font-size="10.5" text-anchor="end">{v}</text>
    </g>
  ))}
  <text x="14" y="26" class="t2" font-size="11.5">gap before each token (ms)</text>
  {gaps.map((g, i) => (
    <rect x={X0 + i * bw + 4} y={yOf(g)} width={bw - 8} height={Y1 - yOf(g)} rx="3" class={g > 60 ? 'red' : 'teal'} />
  ))}
  <line x1={X0} y1={yOf(mean)} x2={X1} y2={yOf(mean)} class="line-a" stroke-width="2" stroke-dasharray="6 4" />
  <text x={X1} y={yOf(mean) - 8} class="ta mono" font-size="11.5" font-weight="700" text-anchor="end">TPOT = average = {mean.toFixed(1)} ms</text>
  <text x={X0 + 9 * bw + bw / 2 + 14} y={yOf(118) + 14} class="tr" font-size="11.5" font-weight="600">118 ms: another user's prefill</text>
  <text x={X0 + 9 * bw + bw / 2 + 14} y={yOf(118) + 29} class="tr" font-size="11.5">ran in this step (a "stall")</text>
  {[1, 6, 12, 18, 24].map((n) => (
    <text x={X0 + (n - 1) * bw + bw / 2} y={Y1 + 16} class="t3 mono" font-size="10.5" text-anchor="middle">{n + 1}</text>
  ))}
  <text x={(X0 + X1) / 2} y={Y1 + 36} class="t2" font-size="11.5" text-anchor="middle">output token number (token 1 has no gap: its wait is part of TTFT)</text>
</svg>
