---
// Prefill multiplies a tall matrix by the weights; decode multiplies one thin row.
---
<svg viewBox="0 0 720 300" role="img" aria-label="Prefill: a 2000 by 4096 activation matrix times a 4096 by 4096 weight matrix, so each weight is used 2000 times. Decode: a 1 by 4096 row times the same weight matrix, so each weight is used once">
  <!-- prefill -->
  <text x="20" y="24" class="t" font-size="13" font-weight="700">Prefill: 2,000 prompt tokens</text>
  <rect x="20" y="44" width="60" height="180" rx="5" class="box-a" />
  {Array.from({ length: 9 }, (_, i) => <line x1="24" y1={62 + i * 18} x2="76" y2={62 + i * 18} class="line-a" stroke-width="0.6" />)}
  <text x="50" y="244" class="t2 mono" font-size="10.5" text-anchor="middle">2000 × 4096</text>
  <text x="50" y="260" class="t3" font-size="10.5" text-anchor="middle">activations</text>
  <text x="98" y="140" class="t" font-size="18" text-anchor="middle">×</text>
  <rect x="116" y="74" width="120" height="120" rx="5" class="violet" />
  <text x="176" y="138" class="tv mono" font-size="11" font-weight="600" text-anchor="middle">W</text>
  <text x="176" y="214" class="t2 mono" font-size="10.5" text-anchor="middle">4096 × 4096</text>
  <text x="176" y="230" class="t3" font-size="10.5" text-anchor="middle">weights (32 MB)</text>
  <text x="256" y="140" class="t" font-size="18" text-anchor="middle">=</text>
  <rect x="274" y="44" width="60" height="180" rx="5" class="box-a" />
  <text x="304" y="244" class="t2 mono" font-size="10.5" text-anchor="middle">2000 × 4096</text>
  <rect x="20" y="272" width="320" height="24" rx="6" class="green" />
  <text x="180" y="288" class="tg" font-size="11.5" font-weight="600" text-anchor="middle">each weight read once, used 2,000 times</text>

  <line x1="362" y1="20" x2="362" y2="296" class="line" stroke-dasharray="3 4" />

  <!-- decode -->
  <text x="384" y="24" class="t" font-size="13" font-weight="700">Decode: 1 new token</text>
  <rect x="384" y="130" width="60" height="9" rx="2" class="box-a" />
  <text x="414" y="160" class="t2 mono" font-size="10.5" text-anchor="middle">1 × 4096</text>
  <text x="462" y="140" class="t" font-size="18" text-anchor="middle">×</text>
  <rect x="480" y="74" width="120" height="120" rx="5" class="violet" />
  <text x="540" y="138" class="tv mono" font-size="11" font-weight="600" text-anchor="middle">W</text>
  <text x="540" y="214" class="t2 mono" font-size="10.5" text-anchor="middle">4096 × 4096</text>
  <text x="540" y="230" class="t3" font-size="10.5" text-anchor="middle">same 32 MB</text>
  <text x="620" y="140" class="t" font-size="18" text-anchor="middle">=</text>
  <rect x="638" y="130" width="60" height="9" rx="2" class="box-a" />
  <text x="668" y="160" class="t2 mono" font-size="10.5" text-anchor="middle">1 × 4096</text>
  <rect x="384" y="272" width="314" height="24" rx="6" class="amber" />
  <text x="541" y="288" class="tam" font-size="11.5" font-weight="600" text-anchor="middle">each weight read once, used 1 time</text>
</svg>
