---
// Embedding lookup: each token ID picks one row of a big table.
const ids = [
  { t: 'The', id: 791 },
  { t: '␣capital', id: 6864 },
  { t: '␣of', id: 315 },
];
const rows = [
  { label: '0', vals: ['0.012', '-0.031', '0.007', '…', '0.020'] },
  { label: '1', vals: ['-0.004', '0.018', '-0.022', '…', '0.009'] },
  { label: '⋮', vals: ['', '', '', '', ''] },
  { label: '315', vals: ['0.026', '-0.011', '0.003', '…', '-0.017'], hi: 2 },
  { label: '⋮', vals: ['', '', '', '', ''] },
  { label: '791', vals: ['-0.008', '0.021', '0.015', '…', '0.004'], hi: 0 },
  { label: '⋮', vals: ['', '', '', '', ''] },
  { label: '6864', vals: ['0.019', '0.002', '-0.027', '…', '0.011'], hi: 1 },
  { label: '⋮', vals: ['', '', '', '', ''] },
  { label: '128255', vals: ['0.001', '-0.013', '0.024', '…', '-0.006'] },
];
---
<svg viewBox="0 0 720 340" role="img" aria-label="Each token ID selects one row of the embedding table. The row is a vector of 4,096 numbers.">
  <defs>
    <marker id="el-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="fill-a" /></marker>
  </defs>
  <text x="16" y="22" class="t" font-size="12.5" font-weight="700">Token IDs</text>
  {ids.map((x, i) => (
    <g>
      <rect x="16" y={40 + i * 46} width="120" height="34" rx="7" class="box-a" />
      <text x="26" y={55 + i * 46} class="t mono" font-size="11">{x.t}</text>
      <text x="26" y={68 + i * 46} class="ta mono" font-size="10.5" font-weight="700">ID {x.id}</text>
    </g>
  ))}

  <text x="200" y="22" class="t" font-size="12.5" font-weight="700">Embedding table: 128,256 rows × 4,096 columns</text>
  <rect x="200" y="32" width="330" height="290" rx="9" class="box" />
  {rows.map((r, i) => (
    <g>
      {r.hi !== undefined && <rect x="204" y={36 + i * 28} width="322" height="24" rx="5" class="box-a" />}
      <text x="246" y={53 + i * 28} class={r.hi !== undefined ? 'ta mono' : 't3 mono'} font-size="10.5" text-anchor="end" font-weight={r.hi !== undefined ? '700' : '400'}>{r.label}</text>
      {r.vals.map((v, j) => <text x={290 + j * 54} y={53 + i * 28} class={r.hi !== undefined ? 't mono' : 't2 mono'} font-size="10.5" text-anchor="middle">{v}</text>)}
    </g>
  ))}
  <!-- arrows from ids to rows -->
  <path d="M138 57 C170 57 170 189 202 189" class="line-a" stroke-width="1.3" marker-end="url(#el-arrow)" />
  <path d="M138 103 C170 103 170 245 202 245" class="line-a" stroke-width="1.3" marker-end="url(#el-arrow)" />
  <path d="M138 149 C165 149 170 133 202 133" class="line-a" stroke-width="1.3" marker-end="url(#el-arrow)" />

  <text x="552" y="22" class="t" font-size="12.5" font-weight="700">Output</text>
  <rect x="552" y="40" width="152" height="140" rx="9" class="box2" />
  <text x="564" y="62" class="t2" font-size="11">3 tokens in →</text>
  <text x="564" y="80" class="t2" font-size="11">3 vectors out,</text>
  <text x="564" y="98" class="t2" font-size="11">each with 4,096</text>
  <text x="564" y="116" class="t2" font-size="11">numbers.</text>
  <text x="564" y="144" class="ta mono" font-size="11" font-weight="700">shape: 3 × 4096</text>
  <text x="564" y="164" class="t3" font-size="10">No math, just a copy.</text>
  <text x="552" y="214" class="t3" font-size="10.5">Numbers in the table</text>
  <text x="552" y="229" class="t3" font-size="10.5">are invented examples.</text>
</svg>
