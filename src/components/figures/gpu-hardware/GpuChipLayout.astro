---
// H100 chip: 8 GPCs full of SMs, L2 cache in the middle, HBM stacks on the sides.
// Zoom from one SM to its contents on the right.
const gpcs = [0, 1, 2, 3, 4, 5, 6, 7];
---
<svg viewBox="0 0 720 340" role="img" aria-label="Plan of an H100 chip: eight GPCs filled with SMs, a shared L2 cache in the middle, and HBM memory stacks on the left and right. One SM is zoomed in on the right.">
  <defs>
    <marker id="gcl-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="fill-a" /></marker>
  </defs>
  <text x="20" y="24" class="t" font-size="13" font-weight="700">The whole chip (H100)</text>

  <!-- HBM stacks -->
  {[0, 1, 2].map((i) => (
    <g>
      <rect x="20" y={46 + i * 88} width="46" height="78" rx="6" class="violet" />
      <text x="43" y={89 + i * 88} class="tv mono" font-size="10" text-anchor="middle">HBM</text>
      <rect x="434" y={46 + i * 88} width="46" height="78" rx="6" class="violet" />
      <text x="457" y={89 + i * 88} class="tv mono" font-size="10" text-anchor="middle">HBM</text>
    </g>
  ))}

  <!-- die -->
  <rect x="76" y="40" width="348" height="270" rx="10" class="box" />
  {gpcs.map((g) => {
    const col = g % 4;
    const row = Math.floor(g / 4);
    const gx = 86 + col * 84;
    const gy = row === 0 ? 50 : 198;
    return (
      <g>
        <rect x={gx} y={gy} width="76" height="102" rx="6" class="box2" />
        <text x={gx + 38} y={gy + 14} class="t3 mono" font-size="9" text-anchor="middle">GPC {g + 1}</text>
        {Array.from({ length: 18 }, (_, s) => (
          <rect x={gx + 6 + (s % 3) * 22} y={gy + 20 + Math.floor(s / 3) * 13} width="19" height="10" rx="2" class={g === 1 && s === 4 ? 'fill-a' : 'box-a'} stroke-width="0.5" />
        ))}
      </g>
    );
  })}
  <rect x="86" y="158" width="328" height="34" rx="6" class="amber" />
  <text x="250" y="180" class="tam" font-size="11.5" font-weight="600" text-anchor="middle">L2 cache · 50 MB · shared by all SMs</text>
  <text x="250" y="330" class="t3" font-size="11" text-anchor="middle">8 GPCs × up to 18 SMs · 132 SMs are switched on in the H100 SXM</text>

  <!-- zoom -->
  <path d="M244 93 C 330 60, 420 30, 506 46" class="line-a" stroke-width="1.3" stroke-dasharray="4 3" marker-end="url(#gcl-arrow)" />
  <rect x="510" y="40" width="194" height="270" rx="12" class="box-a" />
  <text x="607" y="64" class="ta mono" font-size="11" font-weight="600" text-anchor="middle">ONE SM (×132)</text>
  {[
    ['4 warp schedulers', 'pick work every clock'],
    ['128 FP32 cores', 'simple math, 1 number each'],
    ['4 Tensor Cores', 'small matrix multiply'],
    ['256 KB registers', 'fastest memory'],
    ['256 KB L1 / shared', 'fast memory near cores'],
  ].map(([a, b], i) => (
    <g>
      <rect x="524" y={78 + i * 44} width="166" height="38" rx="6" class="box" />
      <text x="534" y={94 + i * 44} class="t" font-size="11.5" font-weight="600">{a}</text>
      <text x="534" y={109 + i * 44} class="t3" font-size="10.5">{b}</text>
    </g>
  ))}
</svg>
