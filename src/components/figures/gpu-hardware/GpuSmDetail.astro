---
// One SM: four sub-partitions (quadrants), each with a warp scheduler, a register
// file, 32 FP32 cores, and 1 Tensor Core. Shared L1 / shared memory at the bottom.
const quads = [
  [20, 20],
  [370, 20],
  [20, 180],
  [370, 180],
];
---
<svg viewBox="0 0 720 400" role="img" aria-label="One SM split into four equal quarters. Each quarter has a warp scheduler, a 64 KB register file, 32 FP32 cores and one Tensor Core. All four share the L1 cache and shared memory.">
  {quads.map(([qx, qy], q) => (
    <g>
      <rect x={qx} y={qy} width="330" height="150" rx="10" class="box" />
      <text x={qx + 12} y={qy + 18} class="t3 mono" font-size="9.5">SUB-PARTITION {q + 1}</text>
      <rect x={qx + 12} y={qy + 26} width="306" height="22" rx="5" class="box2" />
      <text x={qx + 165} y={qy + 41} class="t" font-size="11" font-weight="600" text-anchor="middle">Warp scheduler · picks one warp per clock</text>
      <rect x={qx + 12} y={qy + 54} width="306" height="20" rx="5" class="teal" />
      <text x={qx + 165} y={qy + 68} class="tt" font-size="10.5" font-weight="600" text-anchor="middle">Register file · 64 KB</text>
      <!-- FP32 cores 8 x 4 -->
      {Array.from({ length: 32 }, (_, i) => (
        <rect x={qx + 12 + (i % 8) * 18} y={qy + 82 + Math.floor(i / 8) * 15} width="14" height="11" rx="2" class="box-a" stroke-width="0.6" />
      ))}
      <text x={qx + 12} y={qy + 146} class="t3" font-size="9.5">32 FP32 cores</text>
      <rect x={qx + 170} y={qy + 82} width="148" height="56" rx="7" class="box-a" stroke-width="1.4" />
      <text x={qx + 244} y={qy + 106} class="ta" font-size="12" font-weight="700" text-anchor="middle">Tensor Core</text>
      <text x={qx + 244} y={qy + 124} class="t2" font-size="10" text-anchor="middle">1,024 FLOPs / clock</text>
    </g>
  ))}
  <rect x="20" y="342" width="680" height="40" rx="8" class="amber" />
  <text x="360" y="361" class="tam" font-size="12" font-weight="700" text-anchor="middle">L1 cache + shared memory · 256 KB (up to 228 KB as shared memory)</text>
  <text x="360" y="376" class="t3" font-size="10" text-anchor="middle">shared by all 4 sub-partitions of this SM</text>
</svg>
