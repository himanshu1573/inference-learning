---
// Grid -> blocks -> warps -> threads.
---
<svg viewBox="0 0 720 320" role="img" aria-label="A kernel launch is a grid of blocks. One block of 256 threads is made of 8 warps. One warp is 32 threads that run the same instruction on different data.">
  <defs>
    <marker id="gtw-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="fill-a" /></marker>
  </defs>
  <!-- grid -->
  <text x="20" y="26" class="t" font-size="13" font-weight="700">Grid</text>
  <text x="20" y="43" class="t3" font-size="11">one kernel launch</text>
  <rect x="20" y="56" width="170" height="170" rx="10" class="box" />
  {[0, 1, 2].map((r) =>
    [0, 1, 2].map((c) => (
      <g>
        <rect x={32 + c * 52} y={68 + r * 52} width="44" height="44" rx="6" class={r === 0 && c === 1 ? 'box-a' : 'box2'} />
        <text x={54 + c * 52} y={94 + r * 52} class={r === 0 && c === 1 ? 'ta mono' : 't3 mono'} font-size="9.5" text-anchor="middle">block</text>
      </g>
    )),
  )}
  <text x="105" y="246" class="t3" font-size="10.5" text-anchor="middle">blocks spread over the SMs</text>

  <path d="M130 90 C 170 60, 200 60, 226 70" class="line-a" stroke-width="1.3" stroke-dasharray="4 3" marker-end="url(#gtw-arrow)" />

  <!-- block -->
  <text x="230" y="26" class="t" font-size="13" font-weight="700">One block</text>
  <text x="230" y="43" class="t3" font-size="11">256 threads = 8 warps</text>
  <rect x="230" y="56" width="236" height="170" rx="10" class="box-a" />
  {Array.from({ length: 8 }, (_, w) => (
    <g>
      <text x="240" y={77 + w * 19} class="ta mono" font-size="9">w{w}</text>
      {Array.from({ length: 32 }, (_, t) => (
        <rect x={260 + t * 6.2} y={69 + w * 19} width="4.6" height="10" rx="1" class="fill-a" opacity={w === 2 ? 1 : 0.32} />
      ))}
    </g>
  ))}
  <text x="348" y="246" class="t3" font-size="10.5" text-anchor="middle">each small bar is one thread</text>

  <path d="M462 112 C 490 112, 500 112, 522 112" class="line-a" stroke-width="1.3" stroke-dasharray="4 3" marker-end="url(#gtw-arrow)" />

  <!-- warp -->
  <text x="526" y="26" class="t" font-size="13" font-weight="700">One warp</text>
  <text x="526" y="43" class="t3" font-size="11">32 threads, same instruction</text>
  <rect x="526" y="56" width="178" height="170" rx="10" class="box" />
  <rect x="538" y="68" width="154" height="26" rx="5" class="box2" />
  <text x="615" y="85" class="t mono" font-size="10.5" text-anchor="middle">y = w × x + y</text>
  {Array.from({ length: 8 }, (_, t) => (
    <g>
      <path d={`M${547 + t * 19} 96 V112`} class="line-a" stroke-width="1" />
      <rect x={539 + t * 19} y="114" width="16" height="16" rx="3" class="fill-a" />
    </g>
  ))}
  <text x="615" y="150" class="t2" font-size="10.5" text-anchor="middle">threads 0 … 31</text>
  <text x="615" y="172" class="t2" font-size="10.5" text-anchor="middle">each uses its own data</text>
  <text x="615" y="194" class="t2" font-size="10.5" text-anchor="middle">(a different weight / input)</text>
  <text x="615" y="246" class="t3" font-size="10.5" text-anchor="middle">this is called SIMT</text>

  <text x="360" y="290" class="t" font-size="12" font-weight="600" text-anchor="middle">You write the code for ONE thread. The GPU runs it for thousands of threads,</text>
  <text x="360" y="308" class="t" font-size="12" font-weight="600" text-anchor="middle">in groups of 32 (warps).</text>
</svg>
