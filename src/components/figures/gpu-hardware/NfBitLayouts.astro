---
// Bit layouts of the common number formats, drawn to the same scale.
const formats = [
  { name: 'FP32', sub: '1 + 8 + 23', s: 1, e: 8, m: 23 },
  { name: 'BF16', sub: '1 + 8 + 7', s: 1, e: 8, m: 7 },
  { name: 'FP16', sub: '1 + 5 + 10', s: 1, e: 5, m: 10 },
  { name: 'FP8 E5M2', sub: '1 + 5 + 2', s: 1, e: 5, m: 2 },
  { name: 'FP8 E4M3', sub: '1 + 4 + 3', s: 1, e: 4, m: 3 },
  { name: 'FP4 E2M1', sub: '1 + 2 + 1', s: 1, e: 2, m: 1 },
  { name: 'INT8', sub: '8 integer bits', s: 0, e: 0, m: 0, int: 8 },
];
const x0 = 150;
const cw = 17;
const rowH = 48;
const y0 = 58;
function cells(f: (typeof formats)[number]) {
  const out: { x: number; cls: string }[] = [];
  let i = 0;
  for (let k = 0; k < f.s; k++) out.push({ x: x0 + cw * i++, cls: 'red' });
  for (let k = 0; k < f.e; k++) out.push({ x: x0 + cw * i++, cls: 'box-a' });
  for (let k = 0; k < f.m; k++) out.push({ x: x0 + cw * i++, cls: 'green' });
  for (let k = 0; k < (f.int ?? 0); k++) out.push({ x: x0 + cw * i++, cls: 'box2' });
  return out;
}
function groups(f: (typeof formats)[number]) {
  const g: { x: number; w: number; n: number; cls: string }[] = [];
  let x = x0;
  if (f.int) return [{ x, w: f.int * cw, n: f.int, cls: 't3' }];
  g.push({ x, w: f.s * cw, n: f.s, cls: 'tr' });
  x += f.s * cw;
  g.push({ x, w: f.e * cw, n: f.e, cls: 'ta' });
  x += f.e * cw;
  g.push({ x, w: f.m * cw, n: f.m, cls: 'tg' });
  return g;
}
---
<svg viewBox="0 0 720 400" role="img" aria-label="Bit layouts. FP32: 1 sign, 8 exponent, 23 mantissa bits. BF16: 1, 8, 7. FP16: 1, 5, 10. FP8 E5M2: 1, 5, 2. FP8 E4M3: 1, 4, 3. FP4 E2M1: 1, 2, 1. INT8: 8 integer bits.">
  <!-- legend -->
  <rect x="150" y="16" width="14" height="14" rx="3" class="red" />
  <text x="170" y="27" class="t2" font-size="12">sign</text>
  <rect x="220" y="16" width="14" height="14" rx="3" class="box-a" />
  <text x="240" y="27" class="t2" font-size="12">exponent (range)</text>
  <rect x="356" y="16" width="14" height="14" rx="3" class="green" />
  <text x="376" y="27" class="t2" font-size="12">mantissa (precision)</text>
  <rect x="508" y="16" width="14" height="14" rx="3" class="box2" />
  <text x="528" y="27" class="t2" font-size="12">integer bits</text>

  {formats.map((f, r) => (
    <g>
      <text x="20" y={y0 + r * rowH + 14} class="t" font-size="13" font-weight="700">{f.name}</text>
      <text x="20" y={y0 + r * rowH + 30} class="t3 mono" font-size="10.5">{f.sub}</text>
      {cells(f).map((c) => (
        <rect x={c.x + 1} y={y0 + r * rowH} width={cw - 2} height="22" rx="3" class={c.cls} stroke-width="1" />
      ))}
      {groups(f).map((g) => (
        <text x={g.x + g.w / 2} y={y0 + r * rowH + 37} class={`${g.cls} mono`} font-size="10.5" text-anchor="middle">{g.n}</text>
      ))}
    </g>
  ))}
</svg>
