---
// Four warps take turns: while one waits for memory, another computes.
// The SM stays busy even though each warp waits a lot.
const warps = [
  // [start, length, kind] kind: c = compute, w = wait
  [[0, 2, 'c'], [2, 8, 'w'], [10, 2, 'c'], [12, 6, 'w']],
  [[0, 2, 'q'], [2, 2, 'c'], [4, 8, 'w'], [12, 2, 'c'], [14, 4, 'w']],
  [[0, 4, 'q'], [4, 2, 'c'], [6, 8, 'w'], [14, 2, 'c'], [16, 2, 'w']],
  [[0, 6, 'q'], [6, 2, 'c'], [8, 8, 'w'], [16, 2, 'c']],
] as [number, number, string][][];
const X0 = 110;
const U = 31;
---
<svg viewBox="0 0 720 270" role="img" aria-label="Timeline of four warps. Each warp computes a little, then waits a long time for memory. The scheduler runs another warp during the wait, so the SM is busy almost all the time.">
  {warps.map((segs, w) => (
    <g>
      <text x="20" y={44 + w * 36} class="t2 mono" font-size="11">warp {w + 1}</text>
      {segs.map(([s, l, k]) => (
        k === 'c' ? (
          <rect x={X0 + s * U} y={30 + w * 36} width={l * U - 2} height="22" rx="4" class="fill-a" />
        ) : k === 'w' ? (
          <g>
            <rect x={X0 + s * U} y={30 + w * 36} width={l * U - 2} height="22" rx="4" class="box2" stroke-dasharray="3 3" />
            {l >= 4 && <text x={X0 + s * U + (l * U) / 2} y={45 + w * 36} class="t3" font-size="10" text-anchor="middle">waiting for memory</text>}
          </g>
        ) : (
          <rect x={X0 + s * U} y={30 + w * 36} width={l * U - 2} height="22" rx="4" class="fill-soft" opacity="0.5" />
        )
      ))}
    </g>
  ))}
  <path d={`M${X0} 176 H${X0 + 18 * U}`} class="line" />
  <text x="20" y="206" class="t mono" font-size="11" font-weight="600">SM busy</text>
  {[0, 2, 4, 6, 10, 12, 14, 16].map((s) => (
    <rect x={X0 + s * U} y="192" width={2 * U - 2} height="22" rx="4" class="green" />
  ))}
  <rect x={X0 + 8 * U} y="192" width={2 * U - 2} height="22" rx="4" class="red" />
  <text x={X0 + 9 * U - 1} y="207" class="tr" font-size="9.5" text-anchor="middle">idle</text>
  <text x="20" y="248" class="t2" font-size="11.5">Each warp waits most of the time. But with enough warps, there is almost always one ready to run.</text>
  <text x={X0 + 18 * U} y="236" class="t3 mono" font-size="10.5" text-anchor="end">time →</text>
</svg>
