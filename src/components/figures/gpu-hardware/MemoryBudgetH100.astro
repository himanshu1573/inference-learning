---
// The memory budget of one H100 (80 GB) running Llama 3.1 8B in BF16, with 90% utilisation.
const scale = 660 / 80; // px per GB
const x0 = 30;
const parts = [
  { gb: 16.06, cls: 'box-a', label: 'Weights', val: '16.1 GB', sub: 'fixed, loaded once' },
  { gb: 4, cls: 'box2', label: 'Overhead', val: '~4 GB', sub: 'context, buffers' },
  { gb: 51.94, cls: 'teal', label: 'KV cache pool', val: '~51.9 GB', sub: 'shared by all users' },
  { gb: 8, cls: 'box', label: 'Reserve', val: '8 GB', sub: 'the 10% not used' },
];
let x = x0;
const segs = parts.map((p) => {
  const s = { ...p, x, w: p.gb * scale };
  x += s.w;
  return s;
});
---
<svg viewBox="0 0 720 250" role="img" aria-label="Stacked bar of 80 GB: 16 GB weights, about 4 GB overhead, about 52 GB KV cache, 8 GB reserve">
  <text x="30" y="26" class="t" font-size="13" font-weight="700">One H100 · 80 GB · Llama 3.1 8B in BF16</text>
  <text x="690" y="26" class="t3 mono" font-size="11" text-anchor="end">gpu_memory_utilization = 0.90</text>

  <!-- 90% bracket -->
  <path d={`M${x0} 52 V46 H${x0 + 72 * scale} V52`} class="line-a" stroke-width="1.3" />
  <text x={x0 + 36 * scale} y="42" class="ta mono" font-size="11" text-anchor="middle" font-weight="600">usable by the engine: 72 GB</text>

  {segs.map((s) => (
    <rect x={s.x} y="60" width={s.w} height="56" class={s.cls} stroke-width="1.2" />
  ))}
  <text x={segs[0].x + segs[0].w / 2} y="93" class="ta mono" font-size="12" font-weight="700" text-anchor="middle">16.1</text>
  <text x={segs[2].x + segs[2].w / 2} y="93" class="tt mono" font-size="13" font-weight="700" text-anchor="middle">≈ 51.9 GB for the KV cache</text>
  <text x={segs[3].x + segs[3].w / 2} y="93" class="t3 mono" font-size="11" text-anchor="middle">8</text>

  <!-- axis -->
  {[0, 10, 20, 30, 40, 50, 60, 70, 80].map((g) => (
    <g>
      <path d={`M${x0 + g * scale} 120 V126`} class="line" />
      <text x={x0 + g * scale} y="139" class="t3 mono" font-size="10" text-anchor="middle">{g}</text>
    </g>
  ))}
  <text x="690" y="154" class="t3 mono" font-size="10" text-anchor="end">GB</text>

  <!-- legend -->
  {segs.map((s, i) => (
    <g>
      <rect x={30 + i * 170} y="180" width="14" height="14" rx="3" class={s.cls} />
      <text x={52 + i * 170} y="192" class="t" font-size="12.5" font-weight="700">{s.label}</text>
      <text x={52 + i * 170} y="210" class="ta mono" font-size="11.5">{s.val}</text>
      <text x={52 + i * 170} y="226" class="t3" font-size="11">{s.sub}</text>
    </g>
  ))}
</svg>
