---
// Decode multiplies one row by the weight matrix; prefill multiplies many rows by the same matrix.
---
<svg viewBox="0 0 720 280" role="img" aria-label="Left: in decode, a single row of 4096 numbers is multiplied by a 4096 by 4096 weight matrix, so each weight is used once. Right: in prefill, 1000 rows are multiplied by the same matrix, so each weight is used 1000 times">
  <!-- decode -->
  <text x="20" y="26" class="t" font-size="13" font-weight="700">Decode: 1 new token</text>
  <rect x="20" y="104" width="96" height="10" rx="2" class="box-a" />
  <text x="68" y="134" class="t2 mono" font-size="10.5" text-anchor="middle">1 × 4096</text>
  <text x="130" y="114" class="t2" font-size="18" text-anchor="middle">×</text>
  <rect x="146" y="60" width="98" height="98" rx="4" class="teal" />
  <text x="195" y="106" class="tt" font-size="11" font-weight="700" text-anchor="middle">weights</text>
  <text x="195" y="122" class="t2 mono" font-size="10" text-anchor="middle">4096 × 4096</text>
  <text x="258" y="114" class="t2" font-size="18" text-anchor="middle">=</text>
  <rect x="272" y="104" width="64" height="10" rx="2" class="box" />
  <text x="304" y="134" class="t2 mono" font-size="10.5" text-anchor="middle">1 × 4096</text>
  <rect x="20" y="186" width="316" height="58" rx="8" class="amber" />
  <text x="178" y="208" class="t" font-size="12" font-weight="700" text-anchor="middle">each weight is used for only 1 token</text>
  <text x="178" y="230" class="tam mono" font-size="11.5" font-weight="700" text-anchor="middle">≈ 1 FLOP per byte</text>

  <!-- prefill -->
  <text x="384" y="26" class="t" font-size="13" font-weight="700">Prefill: 1000 prompt tokens</text>
  <rect x="384" y="84" width="96" height="50" rx="3" class="box-a" />
  <text x="432" y="113" class="ta mono" font-size="10.5" text-anchor="middle">1000 × 4096</text>
  <text x="494" y="114" class="t2" font-size="18" text-anchor="middle">×</text>
  <rect x="510" y="60" width="98" height="98" rx="4" class="teal" />
  <text x="559" y="106" class="tt" font-size="11" font-weight="700" text-anchor="middle">same weights</text>
  <text x="559" y="122" class="t2 mono" font-size="10" text-anchor="middle">4096 × 4096</text>
  <text x="622" y="114" class="t2" font-size="18" text-anchor="middle">=</text>
  <rect x="636" y="84" width="64" height="50" rx="3" class="box" />
  <text x="668" y="150" class="t2 mono" font-size="10" text-anchor="middle">1000 × 4096</text>
  <rect x="384" y="186" width="316" height="58" rx="8" class="green" />
  <text x="542" y="208" class="t" font-size="12" font-weight="700" text-anchor="middle">each weight is used for 1000 tokens</text>
  <text x="542" y="230" class="tg mono" font-size="11.5" font-weight="700" text-anchor="middle">≈ 670 FLOPs per byte</text>

  <text x="360" y="270" class="t3" font-size="10.5" text-anchor="middle">Same weight matrix, same bytes to read. Only the amount of work done with each byte changes.</text>
</svg>
