---
// One worker does 8 rows one after another; 8 workers do 8 rows at the same time.
const n = 8;
---
<svg viewBox="0 0 720 290" role="img" aria-label="Left: one worker computes 8 rows one after another and needs 8 time steps. Right: 8 workers each compute one row at the same time and finish in 1 time step.">
  <defs>
    <marker id="wpr-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="t3" /></marker>
  </defs>
  <!-- left: sequential -->
  <text x="20" y="28" class="t" font-size="13" font-weight="700">1 worker</text>
  <text x="20" y="45" class="t3" font-size="11">does the rows one after another</text>
  <text x="20" y="96" class="t2 mono" font-size="11">worker 1</text>
  {Array.from({ length: n }, (_, i) => (
    <g>
      <rect x={86 + i * 34} y="78" width="30" height="28" rx="5" class="box-a" />
      <text x={101 + i * 34} y="96" class="ta mono" font-size="10.5" text-anchor="middle">r{i + 1}</text>
    </g>
  ))}
  <path d="M86 128 H360" class="line-t" stroke-width="1.1" marker-end="url(#wpr-arrow)" />
  <text x="86" y="146" class="t3 mono" font-size="10.5">time →</text>
  <path d="M86 160 V170 M356 160 V170 M86 165 H356" class="line-a" stroke-width="1.4" />
  <text x="221" y="190" class="ta" font-size="12" font-weight="700" text-anchor="middle">8 time steps</text>

  <!-- right: parallel -->
  <text x="420" y="28" class="t" font-size="13" font-weight="700">8 workers</text>
  <text x="420" y="45" class="t3" font-size="11">each does one row, all at the same time</text>
  {Array.from({ length: n }, (_, i) => (
    <g>
      <text x="420" y={72 + i * 24} class="t2 mono" font-size="10.5">worker {i + 1}</text>
      <rect x="490" y={58 + i * 24} width="30" height="20" rx="4" class="box-a" />
      <text x="505" y={72 + i * 24} class="ta mono" font-size="10" text-anchor="middle">r{i + 1}</text>
    </g>
  ))}
  <path d="M490 258 H560" class="line-t" stroke-width="1.1" marker-end="url(#wpr-arrow)" />
  <path d="M490 266 V276 M520 266 V276 M490 271 H520" class="line-a" stroke-width="1.4" />
  <text x="528" y="275" class="ta" font-size="11" font-weight="700">1 step</text>
  <text x="580" y="160" class="ta" font-size="12" font-weight="700">1 time step</text>
  <text x="580" y="178" class="t3" font-size="11">same work,</text>
  <text x="580" y="194" class="t3" font-size="11">8× faster</text>

  <text x="20" y="250" class="t2" font-size="11.5">No row needs the answer of another row.</text>
  <text x="20" y="268" class="t2" font-size="11.5">So the work splits perfectly between workers.</text>
</svg>
