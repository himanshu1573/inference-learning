---
// Decoding the FP16 bit pattern 1 10001 1010000000 step by step = -6.5
const bits = [1, 1, 0, 0, 0, 1, 1, 0, 1, 0, 0, 0, 0, 0, 0, 0];
const x0 = 72;
const cw = 36;
function cls(i: number) {
  if (i === 0) return 'red';
  if (i <= 5) return 'box-a';
  return 'green';
}
function tcls(i: number) {
  if (i === 0) return 'tr';
  if (i <= 5) return 'ta';
  return 'tg';
}
---
<svg viewBox="0 0 720 320" role="img" aria-label="FP16 bits 1, 10001, 1010000000. Sign 1 means negative. Exponent 10001 is 17, minus bias 15 gives 2, so times 4. Mantissa gives 1.625. Value is minus 1 times 4 times 1.625 = minus 6.5.">
  <text x={x0 + cw / 2} y="30" class="tr" font-size="12" font-weight="700" text-anchor="middle">sign</text>
  <text x={x0 + cw + (5 * cw) / 2} y="30" class="ta" font-size="12" font-weight="700" text-anchor="middle">exponent (5 bits)</text>
  <text x={x0 + 6 * cw + (10 * cw) / 2} y="30" class="tg" font-size="12" font-weight="700" text-anchor="middle">mantissa (10 bits)</text>
  {bits.map((b, i) => (
    <g>
      <rect x={x0 + i * cw + 1} y="42" width={cw - 2} height="44" rx="6" class={cls(i)} />
      <text x={x0 + i * cw + cw / 2} y="71" class={`${tcls(i)} mono`} font-size="18" font-weight="700" text-anchor="middle">{b}</text>
    </g>
  ))}
  <!-- brackets -->
  <path d={`M${x0 + 2} 96 V104 H${x0 + cw - 2} V96`} class="sr" stroke-width="1.3" />
  <path d={`M${x0 + cw + 2} 96 V104 H${x0 + 6 * cw - 2} V96`} class="line-a" stroke-width="1.3" />
  <path d={`M${x0 + 6 * cw + 2} 96 V104 H${x0 + 16 * cw - 2} V96`} class="sg" stroke-width="1.3" />

  <!-- sign -->
  <text x="40" y="136" class="t2" font-size="12">1 → negative</text>
  <text x="40" y="156" class="tr mono" font-size="12" font-weight="600">(−1)¹ = −1</text>
  <!-- exponent -->
  <text x="196" y="136" class="t2" font-size="12" text-anchor="middle">10001 (binary) = 17</text>
  <text x="196" y="156" class="t2" font-size="12" text-anchor="middle">17 − 15 (bias) = 2</text>
  <text x="196" y="176" class="ta mono" font-size="12" font-weight="600" text-anchor="middle">2² = 4</text>
  <!-- mantissa -->
  <text x="468" y="136" class="t2" font-size="12" text-anchor="middle">put “1.” in front: 1.1010000000 (binary)</text>
  <text x="468" y="156" class="t2" font-size="12" text-anchor="middle">= 1 + ½ + ⅛</text>
  <text x="468" y="176" class="tg mono" font-size="12" font-weight="600" text-anchor="middle">= 1.625</text>

  <!-- result -->
  <rect x="190" y="212" width="340" height="56" rx="12" class="box-a" />
  <text x="360" y="236" class="t2" font-size="12" text-anchor="middle">value = sign × 2^(exponent − bias) × 1.mantissa</text>
  <text x="360" y="257" class="ta mono" font-size="15" font-weight="700" text-anchor="middle">−1 × 4 × 1.625 = −6.5</text>
  <text x="360" y="298" class="t3" font-size="11" text-anchor="middle">16 bits = 2 bytes hold the number −6.5 exactly</text>
</svg>
