---
// One matrix-vector multiply: W (4096 x 4096) times x (4096) gives y (4096).
// One output number = one row of W "dot" x.
const rows = 10;
---
<svg viewBox="0 0 720 300" role="img" aria-label="A weight matrix W multiplied by an input vector x gives an output vector y. One row of W combined with x gives one number of y.">
  <defs>
    <marker id="wmv-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="fill-a" /></marker>
  </defs>
  <!-- W -->
  <text x="40" y="34" class="t" font-size="13" font-weight="700">Weights W</text>
  <text x="40" y="51" class="t3" font-size="11">4,096 rows × 4,096 columns</text>
  <rect x="40" y="64" width="210" height="200" rx="6" class="box" />
  {Array.from({ length: rows - 1 }, (_, i) => (
    <path d={`M40 ${64 + (i + 1) * 20} H250`} class="line" stroke-width="0.6" />
  ))}
  <rect x="40" y="104" width="210" height="20" class="box-a" stroke-width="1.4" />
  <text x="145" y="118" class="ta mono" font-size="10.5" text-anchor="middle" font-weight="600">row 3</text>
  <text x="145" y="282" class="t3" font-size="11" text-anchor="middle">16.8 million weights</text>

  <!-- times -->
  <text x="268" y="170" class="t2" font-size="20" text-anchor="middle">×</text>

  <!-- x -->
  <text x="300" y="34" class="t" font-size="13" font-weight="700">Input x</text>
  <text x="300" y="51" class="t3" font-size="11">4,096 numbers</text>
  <rect x="300" y="64" width="26" height="200" rx="6" class="box-a" />
  <text x="313" y="282" class="t3" font-size="11" text-anchor="middle">one token</text>

  <!-- equals -->
  <text x="350" y="170" class="t2" font-size="20" text-anchor="middle">=</text>

  <!-- y -->
  <text x="374" y="34" class="t" font-size="13" font-weight="700">Output y</text>
  <text x="374" y="51" class="t3" font-size="11">4,096 numbers</text>
  <rect x="374" y="64" width="26" height="200" rx="6" class="box" />
  <rect x="374" y="104" width="26" height="20" class="fill-a" />

  <path d="M250 96 C 300 84, 350 84, 380 100" class="line-a" stroke-width="1.3" stroke-dasharray="4 3" marker-end="url(#wmv-arrow)" />

  <!-- explanation -->
  <rect x="436" y="64" width="268" height="200" rx="12" class="box2" />
  <text x="452" y="90" class="ta mono" font-size="10.5" font-weight="600">ONE OUTPUT NUMBER</text>
  <text x="452" y="112" class="t" font-size="12.5">= row 3 of W “dot” x</text>
  <text x="452" y="134" class="t2" font-size="11.5">4,096 multiplies (weight × input)</text>
  <text x="452" y="152" class="t2" font-size="11.5">4,096 adds (into one total)</text>
  <path d="M452 168 H688" class="line" stroke-dasharray="3 3" />
  <text x="452" y="190" class="ta mono" font-size="10.5" font-weight="600">ALL 4,096 OUTPUTS</text>
  <text x="452" y="212" class="t" font-size="12.5">2 × 4,096 × 4,096</text>
  <text x="452" y="234" class="t" font-size="12.5" font-weight="700">≈ 33.5 million FLOPs</text>
  <text x="452" y="252" class="t3" font-size="11">= 2 FLOPs for every weight</text>
</svg>
