---
// The roofline of an H100 (BF16) on log-log axes, with decode and prefill points.
const peak = 989; // TFLOPS
const bw = 3.35; // TB/s
const ridge = peak / bw; // ~295 FLOP/byte
const fx = (ai: number) => 80 + (Math.log10(ai) + 1) * 120; // 0.1 .. 10000
const fy = (t: number) => 330 - (Math.log10(t) + 0.5) * 70; // 0.316 .. 3162 TFLOPS
const att = (ai: number) => Math.min(peak, bw * ai);
const pts = [
  { ai: 1, label: 'Decode, batch 1', dx: -12, dy: -12, anchor: 'end' },
  { ai: 64, label: 'Decode, batch 64', dx: -12, dy: -12, anchor: 'end' },
  { ai: 672, label: 'Prefill, 1000 tokens', dx: 10, dy: 24, anchor: 'start' },
];
const xt = [0.1, 1, 10, 100, 1000, 10000];
const yt = [1, 10, 100, 1000];
const fmt = (v: number) => (v >= 1 ? v.toLocaleString('en-US') : String(v));
// angle of the memory roof on screen: 70 px per decade up, 120 px per decade right
const angle = (-Math.atan2(70, 120) * 180) / Math.PI;
const lx = fx(2.2);
const ly = fy(att(2.2)) + 18;
---
<svg viewBox="0 0 720 390" role="img" aria-label="Roofline of an H100: a rising memory roof up to the ridge point at about 295 FLOPs per byte, then a flat compute roof at 989 TFLOPS. Decode at batch 1 sits low on the memory roof, decode at batch 64 sits higher, prefill sits on the compute roof">
  <defs>
    <marker id="rc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="tg" /></marker>
  </defs>
  <!-- regions -->
  <rect x="80" y="40" width={fx(ridge) - 80} height="290" class="amber" style="stroke: none; opacity: 0.45" />
  <rect x={fx(ridge)} y="40" width={680 - fx(ridge)} height="290" class="green" style="stroke: none; opacity: 0.45" />
  <text x="96" y="62" class="tam mono" font-size="11" font-weight="600" letter-spacing="1">MEMORY-BOUND</text>
  <text x="96" y="78" class="t3" font-size="10.5">waiting for data</text>
  <text x="664" y="140" class="tg mono" font-size="11" font-weight="600" letter-spacing="1" text-anchor="end">COMPUTE-BOUND</text>
  <text x="664" y="156" class="t3" font-size="10.5" text-anchor="end">math units are busy</text>

  <!-- grid -->
  {xt.map((v) => (
    <g>
      <line x1={fx(v)} y1="40" x2={fx(v)} y2="330" class="line" stroke-dasharray="2 4" />
      <text x={fx(v)} y="348" class="t3 mono" font-size="10.5" text-anchor="middle">{fmt(v)}</text>
    </g>
  ))}
  {yt.map((v) => (
    <g>
      <line x1="80" y1={fy(v)} x2="680" y2={fy(v)} class="line" stroke-dasharray="2 4" />
      <text x="72" y={fy(v) + 4} class="t3 mono" font-size="10.5" text-anchor="end">{fmt(v)}</text>
    </g>
  ))}
  <rect x="80" y="40" width="600" height="290" class="line" />

  <!-- roof -->
  <path d={`M${fx(0.1)} ${fy(att(0.1))} L${fx(ridge)} ${fy(peak)} H680`} class="line-a" stroke-width="3" stroke-linejoin="round" />
  <text x={lx} y={ly} class="ta" font-size="11.5" font-weight="600" transform={`rotate(${angle} ${lx} ${ly})`}>memory roof = 3.35 TB/s × intensity</text>
  <text x="676" y={fy(peak) - 9} class="ta" font-size="11.5" font-weight="600" text-anchor="end">compute roof = 989 TFLOPS</text>

  <!-- ridge -->
  <line x1={fx(ridge)} y1={fy(peak)} x2={fx(ridge)} y2="330" class="line-t" stroke-dasharray="5 4" />
  <rect x={fx(ridge) - 62} y="296" width="124" height="22" rx="6" class="box" />
  <text x={fx(ridge)} y="311" class="t mono" font-size="10.5" font-weight="600" text-anchor="middle">ridge ≈ 295</text>

  <!-- batching arrow -->
  <path d={`M${fx(1.5)} ${fy(att(1.5)) + 40} L${fx(45)} ${fy(att(45)) + 40}`} class="sg" stroke-width="1.6" stroke-dasharray="5 4" marker-end="url(#rc-arrow)" />
  <text x={fx(8)} y={fy(att(8)) + 58} class="tg" font-size="11" font-weight="600" text-anchor="middle" transform={`rotate(${angle} ${fx(8)} ${fy(att(8)) + 58})`}>bigger batch moves the dot right</text>

  <!-- points -->
  {pts.map((p) => (
    <g>
      <circle cx={fx(p.ai)} cy={fy(att(p.ai))} r="6.5" class="fill-a" style="stroke: var(--surface); stroke-width: 2" />
      <text x={fx(p.ai) + p.dx} y={fy(att(p.ai)) + p.dy} class="t" font-size="11.5" font-weight="700" text-anchor={p.anchor}>{p.label}</text>
    </g>
  ))}

  <!-- axis titles -->
  <text x="380" y="374" class="t2" font-size="11.5" text-anchor="middle">Arithmetic intensity (FLOPs per byte, log scale) →</text>
  <text x="20" y="185" class="t2" font-size="11.5" text-anchor="middle" transform="rotate(-90 20 185)">Speed (TFLOPS, log scale) →</text>
</svg>
