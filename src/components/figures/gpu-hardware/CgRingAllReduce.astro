---
// Ring all-reduce with 4 GPUs: 3 reduce-scatter steps + 3 all-gather steps, each sending S/4.
const gpus = [
  { x: 110, y: 74, n: 0 },
  { x: 270, y: 74, n: 1 },
  { x: 270, y: 214, n: 2 },
  { x: 110, y: 214, n: 3 },
];
const chunkCls = ['box-a', 'green', 'amber', 'violet'];
---
<svg viewBox="0 0 720 320" role="img" aria-label="Ring all-reduce with four GPUs connected in a ring. The data is cut into four chunks. Phase one, reduce-scatter, takes three steps. Phase two, all-gather, takes three steps. In each step every GPU sends one chunk of size S over 4 to its neighbour.">
  <defs>
    <marker id="cg-ring-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="fill-a" /></marker>
  </defs>
  <!-- ring arrows -->
  <path d="M158 62 H218" class="line-a" stroke-width="1.8" marker-end="url(#cg-ring-arrow)" />
  <path d="M310 106 V180" class="line-a" stroke-width="1.8" marker-end="url(#cg-ring-arrow)" />
  <path d="M222 226 H162" class="line-a" stroke-width="1.8" marker-end="url(#cg-ring-arrow)" />
  <path d="M70 182 V108" class="line-a" stroke-width="1.8" marker-end="url(#cg-ring-arrow)" />
  {gpus.map((g) => (
    <g>
      <rect x={g.x - 48} y={g.y - 34} width="96" height="68" rx="10" class="box" />
      <text x={g.x} y={g.y - 12} class="t" font-size="12" font-weight="700" text-anchor="middle">GPU {g.n}</text>
      {chunkCls.map((c, j) => (
        <rect x={g.x - 38 + j * 19.5} y={g.y} width="17" height="17" rx="3" class={c} stroke-width="1" />
      ))}
    </g>
  ))}
  <text x="190" y="290" class="t3" font-size="11" text-anchor="middle">data of size S is cut into N = 4 chunks of size S/4</text>

  <!-- steps -->
  <text x="380" y="40" class="t" font-size="12.5" font-weight="700">Phase 1 · reduce-scatter</text>
  <text x="380" y="56" class="t3" font-size="11">add up chunks while passing them on</text>
  {[0, 1, 2].map((i) => (
    <g>
      <rect x={380 + i * 108} y="68" width="98" height="40" rx="8" class="box-a" />
      <text x={429 + i * 108} y="86" class="ta" font-size="11.5" font-weight="700" text-anchor="middle">step {i + 1}</text>
      <text x={429 + i * 108} y="101" class="t2 mono" font-size="10.5" text-anchor="middle">send S/4</text>
    </g>
  ))}
  <text x="380" y="132" class="t2" font-size="11.5">After phase 1: each GPU holds the full sum of one chunk.</text>

  <text x="380" y="170" class="t" font-size="12.5" font-weight="700">Phase 2 · all-gather</text>
  <text x="380" y="186" class="t3" font-size="11">pass the finished chunks around</text>
  {[0, 1, 2].map((i) => (
    <g>
      <rect x={380 + i * 108} y="198" width="98" height="40" rx="8" class="green" />
      <text x={429 + i * 108} y="216" class="tg" font-size="11.5" font-weight="700" text-anchor="middle">step {i + 4}</text>
      <text x={429 + i * 108} y="231" class="t2 mono" font-size="10.5" text-anchor="middle">send S/4</text>
    </g>
  ))}
  <text x="380" y="262" class="t2" font-size="11.5">After phase 2: every GPU has every summed chunk.</text>
  <rect x="380" y="274" width="318" height="32" rx="8" class="box2" />
  <text x="539" y="295" class="t mono" font-size="12" font-weight="600" text-anchor="middle">each GPU sends 2 × (N−1) × S/N</text>
</svg>
