---
// Where common operations sit on the intensity axis, compared with the H100 ridge point.
const fx = (v: number) => 60 + (Math.log10(v) + 1) * 124; // 0.1 .. 10000
const ridge = 295;
const marks = [
  { v: 0.17, label: 'Add two vectors', val: '0.17', row: 0 },
  { v: 1, label: 'Decode, batch 1', val: '~1', row: 1 },
  { v: 32, label: 'Decode, batch 32', val: '~32', row: 0 },
  { v: 672, label: 'Prefill, 1000 tokens', val: '~670', row: 1 },
  { v: 2731, label: 'Big square matmul', val: '~2,700', row: 0 },
];
const ticks = [0.1, 1, 10, 100, 1000, 10000];
---
<svg viewBox="0 0 720 208" role="img" aria-label="An intensity axis from 0.1 to 10,000 FLOPs per byte. Adding vectors and decode at small batch sizes sit left of the H100 ridge at 295, so they are memory-bound. Prefill and big matrix multiplications sit right of it, so they are compute-bound">
  <rect x="60" y="80" width={fx(ridge) - 60} height="34" class="amber" style="stroke: none" />
  <rect x={fx(ridge)} y="80" width={680 - fx(ridge)} height="34" class="green" style="stroke: none" />
  <line x1="60" y1="114" x2="680" y2="114" class="line-t" stroke-width="1.2" />
  {ticks.map((t) => (
    <g>
      <line x1={fx(t)} y1="114" x2={fx(t)} y2="120" class="line-t" />
      <text x={fx(t)} y="134" class="t3 mono" font-size="10.5" text-anchor="middle">{t.toLocaleString('en-US')}</text>
    </g>
  ))}
  {marks.map((m) => {
    const ty = m.row === 0 ? 26 : 56;
    return (
      <g>
        <line x1={fx(m.v)} y1={ty + 6} x2={fx(m.v)} y2="110" class="line" stroke-dasharray="2 3" />
        <circle cx={fx(m.v)} cy="97" r="5.5" class="fill-a" style="stroke: var(--surface); stroke-width: 2" />
        <text x={fx(m.v)} y={ty - 6} class="t" font-size="11" font-weight="700" text-anchor={m.v < 0.5 ? 'start' : m.v > 2000 ? 'end' : 'middle'} dx={m.v < 0.5 ? -8 : m.v > 2000 ? 12 : 0}>{m.label}</text>
        <text x={fx(m.v)} y={ty + 6} class="ta mono" font-size="10.5" text-anchor={m.v < 0.5 ? 'start' : m.v > 2000 ? 'end' : 'middle'} dx={m.v < 0.5 ? -8 : m.v > 2000 ? 12 : 0}>{m.val}</text>
      </g>
    );
  })}
  <line x1={fx(ridge)} y1="74" x2={fx(ridge)} y2="150" class="line-t" stroke-width="1.5" stroke-dasharray="5 3" />
  <text x={fx(ridge)} y="164" class="t mono" font-size="11" font-weight="700" text-anchor="middle">H100 ridge ≈ 295</text>
  <text x={fx(ridge) - 12} y="190" class="tam" font-size="11.5" font-weight="600" text-anchor="end">← memory-bound on an H100</text>
  <text x={fx(ridge) + 12} y="190" class="tg" font-size="11.5" font-weight="600">compute-bound →</text>
  <text x="680" y="164" class="t3" font-size="10" text-anchor="end">FLOPs per byte</text>
</svg>
