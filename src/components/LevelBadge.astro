---
import { levelNames, type Level } from '../data/curriculum';
interface Props { level: Level; compact?: boolean }
const { level, compact = false } = Astro.props;
---
<span class={`level level-${level}`} title={`Level ${level}: ${levelNames[level]}`}>
  <span class="bars" aria-hidden="true">
    {[1, 2, 3, 4].map((i) => <span class={i <= level ? 'on' : ''} />)}
  </span>
  {!compact && <span class="name">{levelNames[level]}</span>}
  {compact && <span class="sr-only">{levelNames[level]}</span>}
</span>
<style>
  .level {
    --c: var(--green);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--c);
    white-space: nowrap;
  }
  .level-2 { --c: var(--accent-text); }
  .level-3 { --c: var(--violet); }
  .level-4 { --c: var(--red); }
  .bars { display: inline-flex; align-items: flex-end; gap: 2px; height: 11px; }
  .bars span { width: 3px; border-radius: 1px; background: var(--border-strong); }
  .bars span:nth-child(1) { height: 4px; }
  .bars span:nth-child(2) { height: 6px; }
  .bars span:nth-child(3) { height: 8px; }
  .bars span:nth-child(4) { height: 11px; }
  .bars span.on { background: var(--c); }
</style>
