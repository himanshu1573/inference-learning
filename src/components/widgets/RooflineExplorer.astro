---
// Interactive roofline: pick a GPU, model size, weight precision and batch size,
// and see where one decode step lands. Simple model (KV cache ignored):
//   step time = max(weight bytes / bandwidth, 2 · params · batch / peak FLOPS)
interface Props {
  gpu?: 'A100' | 'H100' | 'H200' | 'B200' | 'MI300X';
  model?: number;
  batch?: number;
}
const { gpu = 'H100', model = 8, batch = 1 } = Astro.props;
const gpus = ['A100', 'H100', 'H200', 'B200', 'MI300X'];
const precisions = ['BF16', 'FP8', 'INT4'];
---
<div class="rfx card" data-roofline-explorer data-gpu={gpu} data-model={model} data-batch={batch}>
  <div class="rfx-head">
    <div class="rfx-title">
      <strong>Roofline explorer</strong>
      <span class="live-pill">live</span>
    </div>
    <div class="rfx-seg" role="group" aria-label="GPU">
      {gpus.map((g) => (
        <button type="button" data-gpu-choice={g} aria-pressed={g === gpu ? 'true' : 'false'}>{g}</button>
      ))}
    </div>
  </div>
  <p class="rfx-sub">Move the sliders. The dot shows where one decode step of your model lands on the roofline of the chosen GPU.</p>

  <div class="rfx-body">
    <div class="rfx-controls">
      <label class="rfx-field">
        <span class="rfx-row"><span class="rfx-label">Model size</span><span class="rfx-val"><b data-out="model"></b> B params</span></span>
        <input type="range" data-in="model" min="0" max="8" step="1" />
        <span class="rfx-scale"><span>1B</span><span>405B</span></span>
      </label>
      <label class="rfx-field">
        <span class="rfx-row"><span class="rfx-label">Batch size</span><span class="rfx-val"><b data-out="batch"></b> seqs</span></span>
        <input type="range" data-in="batch" min="0" max="10" step="1" />
        <span class="rfx-scale"><span>1</span><span>1024</span></span>
      </label>
      <div class="rfx-field">
        <span class="rfx-row"><span class="rfx-label">Weight precision</span><span class="rfx-val"><b data-out="bpp"></b> bytes / param</span></span>
        <div class="rfx-seg rfx-seg-full" role="group" aria-label="Weight precision">
          {precisions.map((p) => (
            <button type="button" data-prec-choice={p} aria-pressed={p === 'BF16' ? 'true' : 'false'}>{p}</button>
          ))}
        </div>
      </div>
      <div class="rfx-facts">
        <div><span>Peak math</span><b data-out="peak"></b></div>
        <div><span>Bandwidth</span><b data-out="bw"></b></div>
        <div><span>Ridge point</span><b data-out="ridge"></b></div>
        <div><span>Intensity</span><b data-out="ai"></b></div>
      </div>
    </div>
    <div class="rfx-plot">
      <svg data-plot viewBox="0 0 420 300" role="img" aria-label="Roofline plot for the chosen GPU with the current decode point"></svg>
    </div>
  </div>

  <div class="rfx-results">
    <div class="rfx-cell"><span class="rfx-k">Achieved</span><span class="rfx-v" data-out="att"></span><span class="rfx-s" data-out="pct"></span></div>
    <div class="rfx-cell"><span class="rfx-k">Step time</span><span class="rfx-v" data-out="step"></span><span class="rfx-s" data-out="split"></span></div>
    <div class="rfx-cell"><span class="rfx-k">Whole batch</span><span class="rfx-v" data-out="tps"></span><span class="rfx-s">tokens / s</span></div>
    <div class="rfx-cell"><span class="rfx-k">Each user</span><span class="rfx-v" data-out="tpu"></span><span class="rfx-s">tokens / s</span></div>
  </div>
  <div class="rfx-foot">
    <span class="rfx-badge" data-out="badge"></span>
    <span class="rfx-warn" data-out="warn"></span>
  </div>
  <p class="rfx-note">Simple model: it counts only the weights and ignores the KV cache, so real speeds are lower, especially for long texts and big batches. FP8 uses the FP8 Tensor Core peak where the GPU has one; INT4 weights are unpacked and the math runs in BF16.</p>
</div>

<script>
  type Gpu = { bf16: number; fp8: number | null; bw: number; mem: number };
  // Dense peak TFLOPS, bandwidth in TB/s, memory in GB (approximate datasheet values).
  const GPUS: Record<string, Gpu> = {
    A100: { bf16: 312, fp8: null, bw: 2.04, mem: 80 },
    H100: { bf16: 989, fp8: 1979, bw: 3.35, mem: 80 },
    H200: { bf16: 989, fp8: 1979, bw: 4.8, mem: 141 },
    B200: { bf16: 2250, fp8: 4500, bw: 8.0, mem: 180 },
    MI300X: { bf16: 1307, fp8: 2615, bw: 5.3, mem: 192 },
  };
  const MODELS = [1, 3, 8, 14, 32, 70, 123, 235, 405];
  const BPP: Record<string, number> = { BF16: 2, FP8: 1, INT4: 0.5 };
  const SVG_NS = 'http://www.w3.org/2000/svg';

  // Plot geometry (viewBox 420 × 300)
  const L = 50, R = 412, T = 14, B = 256;
  const X_MIN = -1, X_MAX = 4; // log10 FLOP/byte: 0.1 .. 10,000
  const Y_MIN = -0.5, Y_MAX = 4; // log10 TFLOPS: 0.32 .. 10,000
  const px = (ai: number) => L + ((Math.log10(ai) - X_MIN) / (X_MAX - X_MIN)) * (R - L);
  const py = (t: number) => B - ((Math.log10(t) - Y_MIN) / (Y_MAX - Y_MIN)) * (B - T);

  function el(tag: string, attrs: Record<string, string | number>, text?: string) {
    const node = document.createElementNS(SVG_NS, tag);
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function fmtNum(v: number) {
    if (v >= 100) return Math.round(v).toLocaleString('en-US');
    if (v >= 10) return v.toFixed(1);
    return v.toFixed(2);
  }

  function fmtTime(s: number) {
    if (s >= 1) return s.toFixed(2) + ' s';
    const ms = s * 1000;
    return (ms >= 10 ? ms.toFixed(1) : ms.toFixed(2)) + ' ms';
  }

  function setFill(input: HTMLInputElement) {
    const min = Number(input.min), max = Number(input.max), v = Number(input.value);
    input.style.setProperty('--fill', `${((v - min) / (max - min)) * 100}%`);
  }

  function init(root: HTMLElement) {
    const state = {
      gpu: root.dataset.gpu || 'H100',
      prec: 'BF16',
      modelIdx: Math.max(0, MODELS.indexOf(Number(root.dataset.model) || 8)),
      batchExp: Math.max(0, Math.min(10, Math.round(Math.log2(Number(root.dataset.batch) || 1)))),
    };
    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const out = (name: string) => q<HTMLElement>(`[data-out="${name}"]`);
    const modelIn = q<HTMLInputElement>('[data-in="model"]');
    const batchIn = q<HTMLInputElement>('[data-in="batch"]');
    const svg = q<SVGSVGElement>('[data-plot]');
    modelIn.value = String(state.modelIdx);
    batchIn.value = String(state.batchExp);

    function render() {
      const g = GPUS[state.gpu];
      const P = MODELS[state.modelIdx] * 1e9;
      const batch = 2 ** state.batchExp;
      const bpp = BPP[state.prec];
      const useFp8 = state.prec === 'FP8' && g.fp8 !== null;
      const peak = useFp8 ? (g.fp8 as number) : g.bf16; // TFLOPS
      const weightBytes = P * bpp;
      const flops = 2 * P * batch;
      const tMem = weightBytes / (g.bw * 1e12);
      const tComp = flops / (peak * 1e12);
      const step = Math.max(tMem, tComp);
      const ai = flops / weightBytes; // = 2 · batch / bpp
      const ridge = peak / g.bw;
      const achieved = flops / step / 1e12; // = min(peak, bw · ai)
      const memBound = tMem >= tComp;

      out('model').textContent = String(MODELS[state.modelIdx]);
      out('batch').textContent = String(batch);
      out('bpp').textContent = String(bpp);
      out('peak').textContent = `${peak.toLocaleString('en-US')} TFLOPS`;
      out('bw').textContent = `${g.bw} TB/s`;
      out('ridge').textContent = `${Math.round(ridge)} FLOP/B`;
      out('ai').textContent = `${fmtNum(ai)} FLOP/B`;
      out('att').textContent = `${fmtNum(achieved)} TFLOPS`;
      out('pct').textContent = `${((achieved / peak) * 100).toFixed(achieved / peak < 0.1 ? 1 : 0)}% of peak`;
      out('step').textContent = fmtTime(step);
      out('split').textContent = `memory ${fmtTime(tMem)} · math ${fmtTime(tComp)}`;
      out('tps').textContent = fmtNum(batch / step);
      out('tpu').textContent = fmtNum(1 / step);
      const badge = out('badge');
      badge.textContent = memBound ? 'Memory-bound: waiting for data' : 'Compute-bound: math units are busy';
      badge.classList.toggle('is-mem', memBound);
      badge.classList.toggle('is-comp', !memBound);
      const gb = weightBytes / 1e9;
      out('warn').textContent =
        gb > g.mem
          ? `Weights need ${Math.round(gb)} GB, but one ${state.gpu} has ${g.mem} GB. Real setups split the model over ${Math.ceil(gb / g.mem)}+ GPUs; this view pretends it fits.`
          : `Weights: ${gb >= 10 ? Math.round(gb) : gb.toFixed(1)} GB of ${g.mem} GB on one ${state.gpu}.`;

      root.querySelectorAll<HTMLButtonElement>('[data-gpu-choice]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.gpuChoice === state.gpu)));
      root.querySelectorAll<HTMLButtonElement>('[data-prec-choice]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.precChoice === state.prec)));
      setFill(modelIn);
      setFill(batchIn);

      // ---- plot ----
      svg.replaceChildren();
      const xMid = Math.min(Math.max(px(ridge), L), R);
      svg.append(el('rect', { x: L, y: T, width: xMid - L, height: B - T, class: 'rfx-mem' }));
      svg.append(el('rect', { x: xMid, y: T, width: R - xMid, height: B - T, class: 'rfx-comp' }));
      for (let e = X_MIN; e <= X_MAX; e++) {
        const x = px(10 ** e);
        svg.append(el('line', { x1: x, y1: T, x2: x, y2: B, class: 'rfx-grid' }));
        svg.append(el('text', { x, y: B + 16, class: 'rfx-tick', 'text-anchor': e === X_MAX ? 'end' : 'middle' }, (10 ** e).toLocaleString('en-US')));
      }
      for (let e = 0; e <= Y_MAX; e++) {
        const y = py(10 ** e);
        svg.append(el('line', { x1: L, y1: y, x2: R, y2: y, class: 'rfx-grid' }));
        svg.append(el('text', { x: L - 6, y: y + 4, class: 'rfx-tick', 'text-anchor': 'end' }, (10 ** e).toLocaleString('en-US')));
      }
      svg.append(el('rect', { x: L, y: T, width: R - L, height: B - T, class: 'rfx-frame' }));
      // roof
      const aiStart = 10 ** X_MIN;
      const roof = `M${px(aiStart)} ${py(Math.max(10 ** Y_MIN, g.bw * aiStart))} L${px(ridge)} ${py(peak)} H${R}`;
      svg.append(el('path', { d: roof, class: 'rfx-roof' }));
      svg.append(el('line', { x1: px(ridge), y1: py(peak), x2: px(ridge), y2: B, class: 'rfx-ridge' }));
      svg.append(el('text', { x: R - 4, y: py(peak) - 7, class: 'rfx-lbl', 'text-anchor': 'end' }, `${peak.toLocaleString('en-US')} TFLOPS`));
      svg.append(el('text', { x: px(ridge) + 5, y: B - 8, class: 'rfx-lbl' }, `ridge ${Math.round(ridge)}`));
      // dot (clamped inside the plot)
      const dx = Math.min(Math.max(px(ai), L + 4), R - 4);
      const dy = Math.min(Math.max(py(achieved), T + 4), B - 4);
      svg.append(el('line', { x1: dx, y1: dy, x2: dx, y2: B, class: 'rfx-guide' }));
      svg.append(el('circle', { cx: dx, cy: dy, r: 11, class: 'rfx-halo' }));
      svg.append(el('circle', { cx: dx, cy: dy, r: 6.5, class: 'rfx-dot' }));
      const right = dx < (L + R) / 2;
      svg.append(el('text', { x: dx + (right ? 12 : -12), y: dy + 22, class: 'rfx-dotlbl', 'text-anchor': right ? 'start' : 'end' }, `batch ${batch}`));
      // axis titles
      svg.append(el('text', { x: (L + R) / 2, y: B + 36, class: 'rfx-axis', 'text-anchor': 'middle' }, 'FLOPs per byte (log)'));
      svg.append(el('text', { x: 12, y: (T + B) / 2, class: 'rfx-axis', 'text-anchor': 'middle', transform: `rotate(-90 12 ${(T + B) / 2})` }, 'TFLOPS (log)'));
    }

    root.querySelectorAll<HTMLButtonElement>('[data-gpu-choice]').forEach((b) =>
      b.addEventListener('click', () => {
        state.gpu = b.dataset.gpuChoice!;
        render();
      }),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-prec-choice]').forEach((b) =>
      b.addEventListener('click', () => {
        state.prec = b.dataset.precChoice!;
        render();
      }),
    );
    modelIn.addEventListener('input', () => {
      state.modelIdx = Number(modelIn.value);
      render();
    });
    batchIn.addEventListener('input', () => {
      state.batchExp = Number(batchIn.value);
      render();
    });
    render();
  }

  document.querySelectorAll<HTMLElement>('[data-roofline-explorer]').forEach(init);
</script>

<style is:global>
  .rfx {
    margin: 2.2em 0;
    padding: 18px 20px 16px;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.5;
  }
  .rfx-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .rfx-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
  }
  .rfx-sub {
    margin: 6px 0 14px !important;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-3);
  }
  .rfx-seg {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--surface-3);
  }
  .rfx-seg button {
    border: 0;
    background: transparent;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: 6px;
    cursor: pointer;
  }
  .rfx-seg button:hover {
    color: var(--text);
  }
  .rfx-seg button[aria-pressed='true'] {
    background: var(--accent);
    color: var(--on-accent);
  }
  .rfx-seg-full {
    display: flex;
    margin-top: 6px;
  }
  .rfx-seg-full button {
    flex: 1;
  }
  .rfx-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 18px;
    align-items: start;
  }
  .rfx-controls {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .rfx-field {
    display: block;
    padding: 10px 12px 6px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }
  .rfx-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }
  .rfx-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .rfx-val {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    white-space: nowrap;
  }
  .rfx-val b {
    font-size: 15px;
    color: var(--text);
    margin-right: 2px;
  }
  .rfx-scale {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-3);
  }
  .rfx-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .rfx-facts div {
    display: flex;
    flex-direction: column;
    padding: 7px 10px;
    border-radius: 8px;
    background: var(--surface-3);
    border: 1px solid var(--border);
  }
  .rfx-facts span {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .rfx-facts b {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--accent-text);
  }
  .rfx-plot {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    padding: 6px;
  }
  .rfx-plot svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-mono);
  }
  .rfx-mem {
    fill: var(--amber-soft);
  }
  .rfx-comp {
    fill: var(--green-soft);
  }
  .rfx-grid {
    stroke: var(--border-strong);
    stroke-dasharray: 2 4;
  }
  .rfx-frame {
    fill: none;
    stroke: var(--border-strong);
  }
  .rfx-tick {
    fill: var(--text-3);
    font-size: 9.5px;
  }
  .rfx-axis {
    fill: var(--text-2);
    font-size: 10px;
    font-family: 'Inter', ui-sans-serif, sans-serif;
  }
  .rfx-roof {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .rfx-ridge {
    stroke: var(--text-2);
    stroke-dasharray: 4 3;
  }
  .rfx-lbl {
    fill: var(--accent-text);
    font-size: 10px;
    font-weight: 600;
  }
  .rfx-guide {
    stroke: var(--accent);
    stroke-dasharray: 2 3;
    opacity: 0.6;
  }
  .rfx-halo {
    fill: var(--accent);
    opacity: 0.18;
  }
  .rfx-dot {
    fill: var(--accent);
    stroke: var(--surface);
    stroke-width: 2;
  }
  .rfx-dotlbl {
    fill: var(--text);
    font-size: 10.5px;
    font-weight: 700;
  }
  .rfx-results {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 16px;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface);
  }
  .rfx-cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
    border-left: 1px solid var(--border);
    min-width: 0;
  }
  .rfx-cell:first-child {
    border-left: 0;
  }
  .rfx-k {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .rfx-v {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 700;
    color: var(--accent-text);
    white-space: nowrap;
  }
  .rfx-s {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-3);
  }
  .rfx-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 12px;
  }
  .rfx-badge {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .rfx-badge.is-mem {
    background: var(--amber-soft);
    color: var(--amber);
  }
  .rfx-badge.is-comp {
    background: var(--green-soft);
    color: var(--green);
  }
  .rfx-warn {
    font-size: 12px;
    color: var(--text-2);
  }
  .rfx-note {
    margin-top: 10px !important;
    font-size: 11.5px;
    line-height: 1.55;
    color: var(--text-3);
  }
  @media (max-width: 760px) {
    .rfx-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .rfx-results {
      grid-template-columns: 1fr 1fr;
    }
    .rfx-cell:nth-child(3) {
      border-left: 0;
    }
    .rfx-cell:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
  @media (max-width: 420px) {
    .rfx {
      padding: 14px 12px;
    }
    .rfx-seg button {
      padding: 5px 7px;
      font-size: 11px;
    }
  }
</style>
